<%- include('../layouts/header') %><h1><%= t('common:catalog') %></h1><%- include('nav') %>
<nav class="actions"><a class="button secondary" href="/super-admin/catalog/categories"><%= t('common:categories') %></a><a class="button secondary" href="/super-admin/catalog/ingredients"><%= t('common:ingredients') %></a></nav>
<h2><%= t('common:missing') %></h2><p><%= rows.filter(row=>languages.some(l=>!row.names[l])).length %> / <%= rows.length %></p>
<% for(const row of [...rows,{id:'',key:'',names:{},aliases:[],active:false}]){ %><form class="panel stack" method="post" action="/super-admin/catalog/<%= kind %>"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="id" value="<%= row.id %>"><label><%= t('common:key') %><input name="key" required maxlength="80" pattern="[a-z][a-z0-9_]{1,79}" value="<%= row.key %>" <%= row.id?'readonly':'' %>></label><div class="translation-grid"><% languages.forEach(code=>{ %><div><label><%= localeNames[code] %><input name="<%= code %>" maxlength="150" value="<%= row.names[code]||'' %>" <%= code!=='de'?'required':'' %>></label><% if(kind==='ingredients'){ %><label><%= t('common:aliases') %><input name="aliases_<%= code %>" value="<%= row.aliases.filter(a=>a.language===code).map(a=>a.name).join(', ') %>"></label><% } %><small><%= row.names[code]?t('common:complete'):t('common:missing') %></small></div><% }); %></div><% if(kind==='categories'){ %><label class="checkbox-label"><input name="active" type="checkbox" value="1" <%= row.active?'checked':'' %>><%= t('common:active') %></label><% } %><button class="button"><%= t('common:save') %></button></form><% } %>
<h2><%= t('common:duplicates') %></h2><p><%= t('common:duplicatesHelp') %></p><% duplicates.forEach(pair=>{ %><p><%= pair[0].key %> · <%= pair[1].key %></p><% }); %><%- include('../layouts/footer') %>
