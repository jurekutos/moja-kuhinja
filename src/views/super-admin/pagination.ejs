<% if(pages>1){ %><nav class="pagination" aria-label="<%= t("super-admin:s462411f189f4") %>"><% for(const [p,label] of [[page-1,t("super-admin:s579258446055")],[page+1,t("super-admin:s051dd8e9285b")]]){if(p>=1&&p<=pages){const parameters=new URLSearchParams({page:String(p)});if(typeof query.q==='string')parameters.set('q',query.q);if(typeof query.sort==='string')parameters.set('sort',query.sort); %><a class="button secondary" href="<%= localeUrl((path+'?'+parameters.toString())) %>"><%= label %></a><% }} %><span><%= page %> / <%= pages %></span></nav><% } %>
