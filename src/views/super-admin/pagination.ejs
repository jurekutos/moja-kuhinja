<% if(pages>1){ %><nav class="pagination" aria-label="Strani pregleda"><% for(const [p,label] of [[page-1,'← Prejšnja'],[page+1,'Naslednja →']]){if(p>=1&&p<=pages){const parameters=new URLSearchParams({page:String(p)});if(typeof query.q==='string')parameters.set('q',query.q);if(typeof query.sort==='string')parameters.set('sort',query.sort); %><a class="button secondary" href="<%= path+'?'+parameters.toString() %>"><%= label %></a><% }} %><span><%= page %> / <%= pages %></span></nav><% } %>
