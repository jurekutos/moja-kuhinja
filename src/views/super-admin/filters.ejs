<form method="get" class="filters"><label>Iskanje<input type="search" name="q" maxlength="160" value="<%= typeof query.q==='string'?query.q:'' %>"></label><label>Razvrstitev<select name="sort"><option value="newest">Najnovejši</option><option value="oldest" <%= query.sort==='oldest'?'selected':'' %>>Najstarejši</option><option value="name" <%= query.sort==='name'?'selected':'' %>>Po imenu</option></select></label><button class="button secondary">Poišči</button><a class="text-link" href="<%= path %>">Počisti</a></form><p class="result-count muted">Število zadetkov: <%= count %></p>
