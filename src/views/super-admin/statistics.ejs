<%- include('../layouts/header') %><header class="page-header"><div><p class="eyebrow">GLAVNI SKRBNIK PLATFORME</p><h1>Statistika platforme</h1><p class="muted">Zbirni podatki iz lokalne baze, brez zunanjih analitičnih storitev.</p></div></header><%- include('nav') %><section class="panel"><h2>Vsa šteta odprtja na platformi</h2><%- include('../components/read-counts', { readCounts: stats.reads }) %><p class="muted small">Vsi bralci skupaj, največ eno odprtje na uporabnika na recept na dan. Brez razkrivanja zasebnih receptov.</p><a class="text-link" href="/recipes/statistics">Najbolj brani recepti, ki so mi dostopni →</a></section><div class="settings-columns"><% for(const [heading,rows,unknown] of [['Registracije po mesecih',stats.registrations,stats.unknownUsers],['Novi prostori po mesecih',stats.workspaceCreation,stats.unknownWorkspaces]]){ %><section class="panel stack"><h2><%= heading %></h2><p class="small muted">Največ 24 zadnjih zabeleženih mesecev. Neznani datumi: <%= unknown %>.</p><table class="operations-table"><thead><tr><th>Mesec</th><th>Število</th></tr></thead><tbody><% rows.forEach(row=>{ %><tr><td><%= row.period %></td><td><%= row.count %></td></tr><% }); %></tbody></table><% if(!rows.length){ %><p class="muted">Ni zabeleženih datumov.</p><% } %></section><% } %></div><section class="panel stack"><h2>Recepti po prostorih</h2><p class="small muted">Največ 100 prostorov z največ recepti.</p><table class="operations-table"><thead><tr><th>Prostor</th><th>Recepti</th></tr></thead><tbody><% stats.recipesByWorkspace.forEach(row=>{ %><tr><td><%= row.name %> (#<%= row.id %>)</td><td><%= row.count %></td></tr><% }); %></tbody></table></section><div class="settings-columns"><section class="panel stack"><h2>Načrtovani obroki</h2><table class="operations-table"><thead><tr><th>Obrok</th><th>Število</th></tr></thead><tbody><% stats.meals.forEach(row=>{ %><tr><td><%= row.slot==='lunch'?'Kosilo':'Večerja' %></td><td><%= row.count %></td></tr><% }); %></tbody></table></section><section class="panel stack"><h2>Objave v skupni kuharici</h2><table class="operations-table"><thead><tr><th>Stanje</th><th>Število</th></tr></thead><tbody><% stats.publications.forEach(row=>{ %><tr><td><%= ({pending:'V pregledu',approved:'Odobreno',rejected:'Zavrnjeno ali umaknjeno'})[row.status] %></td><td><%= row.count %></td></tr><% }); %></tbody></table></section></div><%- include('../layouts/footer') %>
