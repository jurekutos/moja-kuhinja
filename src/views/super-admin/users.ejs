<%- include('../layouts/header') %><header class="page-header"><div><p class="eyebrow">GLAVNI SKRBNIK PLATFORME</p><h1>Uporabniki</h1><p class="muted">Pregled računov brez spreminjanja gesel, e-pošte ali platformnih pravic.</p></div></header><%- include('nav') %><%- include('filters') %><div class="stack"><% rows.forEach(account=>{ %><article class="panel stack"><div><h2><%= account.name %></h2><p class="break-word"><%= account.email %></p><p class="small muted">Registracija: <%= account.createdAt?new Date(account.createdAt).toLocaleDateString('sl-SI'):'Datum ni zabeležen' %> · Članstva: <%= account.memberships.length %></p></div><div class="tags"><% if(account.isModerator){ %><span>Moderator</span><% } %><% if(account.isSuperAdmin){ %><span>Glavni skrbnik</span><% } %></div><ul class="stack"><% account.memberships.forEach(m=>{ %><li><a class="text-link" href="/super-admin/workspaces/<%= m.workspaceId %>"><%= m.name %></a> · <%= ({admin:'Skrbnik',editor:'Urednik',viewer:'Samo branje'})[m.role] %></li><% }); %></ul><% if(!account.memberships.length){ %><p class="muted">Brez članstev.</p><% } %></article><% }); %></div><% if(!rows.length){ %><p class="panel muted">Ni računov za izbrane pogoje.</p><% } %><%- include('pagination') %><%- include('../layouts/footer') %>
