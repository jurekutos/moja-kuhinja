<%- include('../layouts/header') %><header class="page-header"><div><p class="eyebrow"><%= t("super-admin:sf603b1b79cf6") %></p><h1><%= t("super-admin:s9afb49cffa3f") %></h1><p class="muted"><%= t("super-admin:s7e6bb73584a4") %></p></div></header><%- include('nav') %><%- include('filters') %><div class="stack"><% rows.forEach(account=>{ %><article class="panel stack"><div><h2><%= account.name %></h2><p class="break-word"><%= account.email %></p><p class="small muted"><%= t("super-admin:s56b2759ecd05") %> <%= account.createdAt?new Date(account.createdAt).toLocaleDateString(locale,{timeZone:'Europe/Ljubljana'}):t("super-admin:sb659c6473135") %> <%= t("super-admin:sac7f7fe4f41f") %> <%= account.memberships.length %></p></div><div class="tags"><% if(account.isModerator){ %><span><%= t("super-admin:s6748ec8b7668") %></span><% } %><% if(account.isSuperAdmin){ %><span><%= t("super-admin:sd0d043d1ae82") %></span><% } %></div><ul class="stack"><% account.memberships.forEach(m=>{ %><li><a class="text-link" href="/super-admin/workspaces/<%= m.workspaceId %>"><%= m.name %></a> · <%= ({admin:t("super-admin:s7246e87eb0ab"),editor:t("super-admin:s5f93461e96bf"),viewer:t("super-admin:sbc6f98e47b3d")})[m.role] %></li><% }); %></ul><% if(!account.memberships.length){ %><p class="muted"><%= t("super-admin:s546090533b1c") %></p><% } %></article><% }); %></div><% if(!rows.length){ %><p class="panel muted"><%= t("super-admin:s6905d758704a") %></p><% } %><%- include('pagination') %><%- include('../layouts/footer') %>
