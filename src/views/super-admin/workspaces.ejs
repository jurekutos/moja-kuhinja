<%- include('../layouts/header') %><header class="page-header"><div><p class="eyebrow">GLAVNI SKRBNIK PLATFORME</p><h1>Prostori</h1></div></header><%- include('nav') %><%- include('filters') %><div class="stack"><% rows.forEach(workspace=>{ %><article class="panel member-row"><div><h2><%= workspace.name %></h2><p class="small muted">ID: <%= workspace.id %> · Ustvarjeno: <%= workspace.createdAt?new Date(workspace.createdAt).toLocaleDateString('sl-SI'):'Datum ni zabeležen' %></p><p>Člani: <%= workspace.memberCount %> · Recepti: <%= workspace.recipeCount %></p><p class="small muted">Skrbniki: <%= workspace.admins.join(', ')||'Ni skrbnika' %></p></div><a class="button secondary" href="/super-admin/workspaces/<%= workspace.id %>">Upravljaj prostor</a></article><% }); %></div><% if(!rows.length){ %><p class="panel muted">Ni prostorov za izbrane pogoje.</p><% } %><%- include('pagination') %><%- include('../layouts/footer') %>
