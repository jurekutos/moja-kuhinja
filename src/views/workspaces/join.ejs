<%- include('../layouts/header') %><div class="join-shell panel stack"><a class="brand" href="<%= localeUrl("/") %>"><span class="brand-icon">m.</span><span>moja kuhinja</span></a><p class="eyebrow"><%= t("workspaces:s959296ca8e12") %></p><h1><%= invitation.householdName ? t("workspaces:s0a145273f404") : t("workspaces:sfb456b35a9dd") %></h1><p><% if (invitation.householdName) { %><%= t("workspaces:s11bd1bec0e4f") %> <strong><%= invitation.householdName %></strong><%= t("workspaces:s7c47af7f9ce6") %> <%= ({admin:t("workspaces:s7246e87eb0ab"),editor:t("workspaces:s5f93461e96bf"),viewer:t("workspaces:sbc6f98e47b3d")})[invitation.role] %>.<% } else { %><%= t("workspaces:s6f361ffffbcf") %><% } %></p><p class="muted"><%= t("workspaces:sb7e20db876ee") %> <strong><%= invitation.email %></strong><%= t("workspaces:sa7e380b28c86") %> <%= new Date(invitation.expiresAt).toLocaleDateString(locale,{timeZone:'Europe/Ljubljana'}) %>.</p>
<% if (errors.length) { %><div class="errors" role="alert"><% errors.forEach(error => { %><p><%= error %></p><% }); %></div><% } %>
<% if (user && user.email !== invitation.email) { %><p class="errors"><%= t("workspaces:s220f60d83e18") %></p><form method="post" action="<%= localeUrl("/logout") %>"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="button"><%= t("workspaces:sa0b33286dccb") %></button></form><% } else { %>
<% if (!user) { %><p class="small muted"><%= t("workspaces:s3f23a07a494d") %> <a class="text-link" href="<%= localeUrl("/login") %>"><%= t("workspaces:s24f28c86f7bd") %></a><%= t("workspaces:sebba57bbdff9") %></p><% } %><form method="post" action="<%= localeUrl("/join/" + (token)) %>" class="stack"><input type="hidden" name="_csrf" value="<%= csrf %>">
<% if (!user) { %><label><%= t("workspaces:s1f5038968692") %><input name="name" required maxlength="100" autocomplete="name" value="<%= values.name %>"></label><label><%= t("workspaces:s1a14ac1e9352") %><input type="email" value="<%= invitation.email %>" readonly autocomplete="username"></label><label><%= t("workspaces:se21eeeca819d") %><input type="password" name="password" required minlength="8" maxlength="1024" autocomplete="new-password"></label><label><%= t("workspaces:s19c0f8dca747") %><input type="password" name="confirmation" required minlength="8" maxlength="1024" autocomplete="new-password"></label><small><%= t("workspaces:s68d2ca6e5b58") %></small><% } %>
<% if (!invitation.householdId) { %><label><%= t("workspaces:sb6bc594206aa") %><input name="workspaceName" required maxlength="100" placeholder="<%= t("workspaces:s3d5739e39310") %>" value="<%= values.workspaceName %>"></label><% } %><button class="button"><%= invitation.householdId ? t("workspaces:s0de597a33593") : t("workspaces:sc6768ec2f6e7") %></button></form><% } %></div><%- include('../layouts/footer') %>
