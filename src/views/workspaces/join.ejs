<%- include('../layouts/header') %><div class="join-shell panel stack"><a class="brand" href="/"><span class="brand-icon">m.</span><span>moja kuhinja</span></a><p class="eyebrow">POVABILO V KUHINJO</p><h1><%= invitation.householdName ? 'Pridružite se prostoru' : 'Ustvarite svoj prostor' %></h1><p><% if (invitation.householdName) { %>Prostor: <strong><%= invitation.householdName %></strong>. Vloga: <%= ({admin:'Skrbnik',editor:'Urednik',viewer:'Samo branje'})[invitation.role] %>.<% } else { %>Ustvarite zasebno kuhinjo in postanite njen skrbnik.<% } %></p><p class="muted">Povabilo za <strong><%= invitation.email %></strong>. Velja do <%= new Date(invitation.expiresAt).toLocaleDateString('sl-SI') %>.</p>
<% if (errors.length) { %><div class="errors" role="alert"><% errors.forEach(error => { %><p><%= error %></p><% }); %></div><% } %>
<% if (user && user.email !== invitation.email) { %><p class="errors">Prijavljeni ste z drugim računom. Odjavite se in uporabite naslov, na katerega je vezano povabilo.</p><form method="post" action="/logout"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="button">Odjava</button></form><% } else { %>
<% if (!user) { %><p class="small muted">Že imate račun? <a class="text-link" href="/login">Najprej se prijavite</a>, nato se boste vrnili na povabilo.</p><% } %><form method="post" action="/join/<%= token %>" class="stack"><input type="hidden" name="_csrf" value="<%= csrf %>">
<% if (!user) { %><label>Vaše ime<input name="name" required maxlength="100" autocomplete="name" value="<%= values.name %>"></label><label>E-poštni naslov<input type="email" value="<%= invitation.email %>" readonly autocomplete="username"></label><label>Geslo<input type="password" name="password" required minlength="8" maxlength="1024" autocomplete="new-password"></label><label>Ponovite geslo<input type="password" name="confirmation" required minlength="8" maxlength="1024" autocomplete="new-password"></label><small>Najmanj 8 znakov. Obe gesli se morata ujemati.</small><% } %>
<% if (!invitation.householdId) { %><label>Ime vašega prostora<input name="workspaceName" required maxlength="100" placeholder="Naša kuhinja" value="<%= values.workspaceName %>"></label><% } %><button class="button"><%= invitation.householdId ? 'Sprejmi povabilo' : 'Ustvari prostor' %></button></form><% } %></div><%- include('../layouts/footer') %>
