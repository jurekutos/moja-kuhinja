<%- include('../layouts/header') %><header class="page-header"><div><p class="eyebrow"><%= t("workspaces:s7d4979098b8d") %></p><h1><%= user.householdName %></h1><p class="muted"><%= t("workspaces:s9b27cdc26f8b") %> <%= ({admin:t("workspaces:s7246e87eb0ab"),editor:t("workspaces:s5f93461e96bf"),viewer:t("workspaces:sbc6f98e47b3d")})[user.role] %></p></div><a class="button secondary" href="/submissions"><%= t("workspaces:sf15eca623e46") %></a></header><%- include('../components/invitation-link') %>
<section class="panel stack"><h2><%= t("workspaces:sf2815dc0bfb0") %></h2><p class="small muted"><%= t("workspaces:s70b0e39ef621") %></p><% people.forEach(person => { %><div class="member-row"><div><strong><%= person.name %><%= person.userId === user.id ? ' (' + t('common:you') + ')'  : '' %></strong><p class="small muted"><%= person.email %></p></div><% if (user.role === 'admin') { %><form method="post" action="/workspace/members/<%= person.userId %>" class="member-controls"><input type="hidden" name="_csrf" value="<%= csrf %>"><label><%= t("workspaces:s62f65bf8ec12") %> <%= person.name %><select name="role"><% for (const [value,label] of [['admin',t("workspaces:s7246e87eb0ab")],['editor',t("workspaces:s5f93461e96bf")],['viewer',t("workspaces:sbc6f98e47b3d")]]) { %><option value="<%= value %>" <%= person.role === value ? 'selected' : '' %>><%= label %></option><% } %></select></label><button class="button secondary"><%= t("workspaces:s236c9618f25e") %></button></form><form method="post" action="/workspace/members/<%= person.userId %>" data-confirm="<%= t("workspaces:s2d98d36e148f") %>"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="role" value="remove"><button class="text-link danger"><%= t("workspaces:sb35ae30e70a0") %></button></form><% } else { %><span class="tag"><%= ({admin:t("workspaces:s7246e87eb0ab"),editor:t("workspaces:s5f93461e96bf"),viewer:t("workspaces:sbc6f98e47b3d")})[person.role] %></span><% } %></div><% }); %></section>
<% if (user.role === 'admin') { %><section class="panel stack"><h2><%= t("workspaces:sc4a3d7a1c392") %></h2><p class="muted"><%= t("workspaces:sd57e7251f1c3") %></p><form action="/workspace/invitations" method="post" class="stack"><input type="hidden" name="_csrf" value="<%= csrf %>"><label><%= t("workspaces:s35ea42733ae4") %><input name="email" type="email" required maxlength="254"></label><label><%= t("workspaces:secb9c91003f7") %><select name="role"><option value="editor"><%= t("workspaces:s5f93461e96bf") %></option><option value="viewer"><%= t("workspaces:sbc6f98e47b3d") %></option><option value="admin"><%= t("workspaces:s7246e87eb0ab") %></option></select></label><div><button class="button"><%= t("workspaces:s061d7307c333") %></button></div></form></section><section class="panel stack"><h2><%= t("workspaces:sc24b4dbb8d64") %></h2><%- include('../components/invitation-list') %></section><% } %><%- include('../components/workspace-actions') %><%- include('../layouts/footer') %>
