<%- include('../layouts/header') %><header class="page-header"><div><p class="eyebrow">VAŠI LJUDJE, VAŠI OKUSI</p><h1><%= user.householdName %></h1><p class="muted">Vaša vloga: <%= ({admin:'Skrbnik',editor:'Urednik',viewer:'Samo branje'})[user.role] %></p></div><a class="button secondary" href="/submissions">Oddaje v skupno kuharico →</a></header><%- include('../components/invitation-link') %>
<section class="panel stack"><h2>Člani prostora</h2><p class="small muted">Skrbniki upravljajo člane in recepte. Uredniki urejajo recepte. Bralci lahko kuhajo, komentirajo in shranjujejo svoje priljubljene ter zasebne opombe.</p><% people.forEach(person => { %><div class="member-row"><div><strong><%= person.name %><%= person.userId === user.id ? ' (vi)' : '' %></strong><p class="small muted"><%= person.email %></p></div><% if (user.role === 'admin') { %><form method="post" action="/workspace/members/<%= person.userId %>" class="member-controls"><input type="hidden" name="_csrf" value="<%= csrf %>"><label>Vloga za <%= person.name %><select name="role"><% for (const [value,label] of [['admin','Skrbnik'],['editor','Urednik'],['viewer','Samo branje']]) { %><option value="<%= value %>" <%= person.role === value ? 'selected' : '' %>><%= label %></option><% } %></select></label><button class="button secondary">Shrani vlogo</button></form><form method="post" action="/workspace/members/<%= person.userId %>" data-confirm="Odstranim tega člana iz prostora?"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="role" value="remove"><button class="text-link danger">Odstrani člana</button></form><% } else { %><span class="tag"><%= ({admin:'Skrbnik',editor:'Urednik',viewer:'Samo branje'})[person.role] %></span><% } %></div><% }); %></section>
<% if (user.role === 'admin') { %><section class="panel stack"><h2>Povabi člana</h2><p class="muted">Povezavo delite osebno. Povabilo velja 7 dni in je vezano na e-poštni naslov. Obstoječi uporabnik se lahko pridruži tudi dodatnemu prostoru.</p><form action="/workspace/invitations" method="post" class="stack"><input type="hidden" name="_csrf" value="<%= csrf %>"><label>E-poštni naslov povabljene osebe<input name="email" type="email" required maxlength="254"></label><label>Vloga novega člana<select name="role"><option value="editor">Urednik</option><option value="viewer">Samo branje</option><option value="admin">Skrbnik</option></select></label><div><button class="button">Ustvari povabilo</button></div></form></section><section class="panel stack"><h2>Povabila</h2><%- include('../components/invitation-list') %></section><% } %><%- include('../components/workspace-actions') %><%- include('../layouts/footer') %>
