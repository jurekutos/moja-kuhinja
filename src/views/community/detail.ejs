<%- include('../layouts/header') %><% if (typeof readCounts !== 'undefined' && readCounts) { %><%- include('../components/read-counts', { readCounts }) %><% } %><% const recipe = publication.recipe; %><a class="back-link" href="<%= publication.status === 'approved' ? '/community' : '/submissions' %>">← Nazaj v zbirko</a><header class="page-header"><div><p class="eyebrow">SKUPNA KUHARICA</p><h1><%= recipe.title %></h1><p class="small muted">Avtor: <% if (publication.status === 'approved') { %><a class="text-link" href="/recipes?view=public&amp;author=<%= publication.submittedBy %>"><%= recipe.author %></a><% } else { %><%= recipe.author %><% } %></p><p class="muted preserve"><%= recipe.description %></p><p class="small muted"><%= ({pending:'V pregledu',approved:'Odobreno',rejected:'Zavrnjeno ali umaknjeno'})[publication.status] %></p></div><div class="actions"><% if (publication.status === 'approved') { %><form method="post" action="/community/<%= publication.id %>/favorite"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="button secondary" aria-pressed="<%= publication.favorite %>"><%= publication.favorite ? '♥ Priljubljen' : '♡ Med priljubljene' %></button></form><% if (user.role !== 'viewer') { %><form method="post" action="/community/<%= publication.id %>/copy"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="button">Kopiraj v moj prostor</button></form><% } %><% } %></div></header>
<% if (publication.feedback) { %><div class="notice"><strong>Povratna informacija moderatorja</strong><p class="preserve"><%= publication.feedback %></p></div><% } %><% if (recipe.images.length) { %><div class="detail-cover"><img src="/community/<%= publication.id %>/images/0" alt="<%= recipe.title %>" width="1600" height="1000"></div><% } %>
<div class="recipe-meta"><div><small>PRIPRAVA</small><strong><%= recipe.prepMinutes %> min</strong></div><div><small>KUHANJE</small><strong><%= recipe.cookMinutes %> min</strong></div></div><div class="detail-columns"><section class="panel"><h2>Sestavine</h2><label class="servings-control">Porcije<input id="servings" type="number" min="1" max="100" value="<%= recipe.servings %>" data-base="<%= recipe.servings %>"></label><p id="servings-error" class="danger" role="status"></p><ul class="ingredient-list"><% recipe.ingredients.forEach(i => { %><li><strong data-quantity="<%= i.quantity ?? '' %>"><%= scaleQuantity(i.quantity, recipe.servings, recipe.servings) %></strong> <%= i.unit %> <%= i.name %><% if (i.note) { %><small class="muted"> — <%= i.note %></small><% } %></li><% }); %></ul></section><section class="panel"><h2>Priprava</h2><ol class="step-list"><% recipe.steps.forEach((step,index) => { %><li><span class="step-number"><%= index+1 %></span><p class="preserve"><%= step %></p></li><% }); %></ol></section></div>
<% if (recipe.images.length > 1) { %><section class="gallery"><% recipe.images.slice(1).forEach((image,index) => { %><a href="/community/<%= publication.id %>/images/<%= index+1 %>"><img src="/community/<%= publication.id %>/images/<%= index+1 %>?size=small" alt="Dodatna fotografija recepta" loading="lazy" width="600" height="450"></a><% }); %></section><% } %><section class="panel stack"><h2>O skupnem receptu</h2><% if (publication.householdId === user.householdId && publication.recipeId) { %><a class="text-link" href="/recipes/<%= publication.recipeId %>">Odpri izvirni recept v mojem prostoru →</a><% } %><p class="small muted">To je kopija, oddana v pregled. Spremembe izvirnega zasebnega recepta se tu ne objavijo samodejno. Osebne opombe in pogovori prostora niso vključeni.</p><% if (recipe.sourceDescription) { %><p><%= recipe.sourceDescription %></p><% } %><% if (recipe.sourceUrl) { %><a href="<%= recipe.sourceUrl %>" target="_blank" rel="noopener noreferrer" class="text-link">Odpri izvirni vir ↗</a><% } %></section>
<% if (user.isModerator && ['pending','approved'].includes(publication.status)) { %><section class="panel stack"><h2><%= publication.status === 'pending' ? 'Pregled moderatorja' : 'Upravljanje objave' %></h2><form action="/community/<%= publication.id %>/review" method="post" class="stack"><input type="hidden" name="_csrf" value="<%= csrf %>"><label>Obrazložitev<textarea name="feedback" rows="3" maxlength="2000" placeholder="Obvezna pri zavrnitvi ali umiku."></textarea></label><div class="actions"><% if (publication.status === 'pending') { %><button class="button" name="decision" value="approved">Odobri objavo</button><% } %><button class="button secondary" name="decision" value="rejected"><%= publication.status === 'pending' ? 'Zavrni oddajo' : 'Umakni iz skupne kuharice' %></button></div></form></section><% } %><%- include('../layouts/footer') %>
