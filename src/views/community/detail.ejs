<%- include('../layouts/header') %><% if (typeof readCounts !== 'undefined' && readCounts) { %><%- include('../components/read-counts', { readCounts }) %><% } %><% const recipe = publication.recipe; %><a class="back-link" href="<%= localeUrl((publication.status === 'approved' ? '/community' : '/submissions')) %>"><%= t("community:seca0e204c6f4") %></a><header class="page-header"><div><p class="eyebrow"><%= t("community:se723bd0795c2") %></p><h1><%= recipe.title %></h1><p class="small muted"><%= t("community:sa45dd918ddd9") %> <% if (publication.status === 'approved') { %><a class="text-link" href="<%= localeUrl("/recipes?view=public&author=" + (publication.submittedBy)) %>"><%= recipe.author %></a><% } else { %><%= recipe.author %><% } %></p><p class="muted preserve"><%= recipe.description %></p><p class="small muted"><%= ({draft:t('common:draft'),pending:t('common:pending'),approved:t("community:s34161d73dbe0"),rejected:t("community:s4344354ccbed")})[publication.status] %></p></div><div class="actions"><% if (publication.status === 'approved') { %><form method="post" action="<%= localeUrl("/community/" + (publication.id) + "/favorite") %>"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="language" value="<%= publication.language %>"><button class="button secondary" aria-pressed="<%= publication.favorite %>"><%= publication.favorite ? t("community:scf71b8366577") : t("community:sd3d611d39def") %></button></form><% if (user.role !== 'viewer') { %><form method="post" action="<%= localeUrl("/community/" + (publication.id) + "/copy") %>"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="language" value="<%= publication.language %>"><button class="button"><%= t("community:sf0920a37918b") %></button></form><% } %><% } %></div></header>
<% if (publication.feedback) { %><div class="notice"><strong><%= t("community:s8740d4b3d7b2") %></strong><p class="preserve"><%= publication.feedback %></p></div><% } %><% if (recipe.images.length) { %><div class="detail-cover"><img src="<%= localeUrl("/community/" + (publication.id) + "/images/0?reviewLanguage=" + (publication.reviewMode ? publication.language : '')) %>" alt="<%= recipe.title %>" width="1600" height="1000"></div><% } %>
<div class="recipe-meta"><div><small><%= t("community:sd9a76dde0984") %></small><strong><%= recipe.prepMinutes %> <%= t("community:s1f6fa6f69d18") %></strong></div><div><small><%= t("community:sa4a6f6c256c9") %></small><strong><%= recipe.cookMinutes %> <%= t("community:s1f6fa6f69d18") %></strong></div></div><div class="detail-columns"><section class="panel"><h2><%= t("community:s49527351414c") %></h2><label class="servings-control"><%= t("community:sd97145bb4a5d") %><input id="servings" type="number" min="1" max="100" value="<%= recipe.servings %>" data-base="<%= recipe.servings %>"></label><p id="servings-error" class="danger" role="status"></p><ul class="ingredient-list"><% recipe.ingredients.forEach(i => { %><li><strong data-quantity="<%= i.quantity ?? '' %>"><%= scaleQuantity(i.quantity, recipe.servings, recipe.servings) %></strong> <%= unitLabel(i.unit) %> <%= i.name %><% if (i.note) { %><small class="muted"> — <%= i.note %></small><% } %></li><% }); %></ul></section><section class="panel"><h2><%= t("community:s4dd38350a781") %></h2><ol class="step-list"><% recipe.steps.forEach((step,index) => { %><li><span class="step-number"><%= index+1 %></span><p class="preserve"><%= step %></p></li><% }); %></ol></section></div>
<% if (recipe.images.length > 1) { %><section class="gallery"><% recipe.images.slice(1).forEach((image,index) => { %><a href="<%= localeUrl("/community/" + (publication.id) + "/images/" + (index+1) + "?reviewLanguage=" + (publication.reviewMode ? publication.language : '')) %>"><img src="<%= localeUrl("/community/" + (publication.id) + "/images/" + (index+1) + "?size=small&reviewLanguage=" + (publication.reviewMode ? publication.language : '')) %>" alt="<%= t("community:sd30a73122890") %>" loading="lazy" width="600" height="450"></a><% }); %></section><% } %><section class="panel stack"><h2><%= t("community:s4604c7f0d81d") %></h2><% if (publication.householdId === user.householdId && publication.recipeId) { %><a class="text-link" href="<%= localeUrl("/recipes/" + (publication.recipeId)) %>"><%= t("community:sbe720d4e0fc5") %></a><% } %><p class="small muted"><%= t("community:s0b55837278d8") %></p><% if (recipe.sourceDescription) { %><p><%= recipe.sourceDescription %></p><% } %><% if (recipe.sourceUrl) { %><a href="<%= localeUrl((recipe.sourceUrl)) %>" target="_blank" rel="noopener noreferrer" class="text-link"><%= t("community:s369bdc28e1b0") %></a><% } %></section>
<% if (user.isModerator && ['pending','approved'].includes(publication.status)) { %><section class="panel stack"><h2><%= publication.status === 'pending' ? t("community:sa0d559022371") : t("community:s1391cea1dd0e") %></h2><form action="<%= localeUrl("/community/" + (publication.id) + "/review") %>" method="post" class="stack"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="language" value="<%= publication.language %>"><label><%= t("community:s174ae1e80fd6") %><textarea name="feedback" rows="3" maxlength="2000" placeholder="<%= t("community:s0c6a0280f3e5") %>"></textarea></label><div class="actions"><% if (publication.status === 'pending') { %><button class="button" name="decision" value="approved"><%= t("community:se1415b0da90a") %></button><% } %><button class="button secondary" name="decision" value="rejected"><%= publication.status === 'pending' ? t("community:s5d1dad8b8860") : t("community:see31989b3592") %></button></div></form></section><% } %><%- include('../components/public-language-submission') %><%- include('../layouts/footer') %>
