<%- include('../layouts/header') %><header class="page-header"><div><p class="eyebrow">DOBRO JE DELITI</p><h1><%= title %></h1><p class="muted"><%= collectionScope === 'approved' ? 'Odobreni recepti iz drugih kuhinj. Shranite priljubljene ali ustvarite svojo kopijo.' : collectionScope === 'mine' ? 'Pregled, odobritve in povratne informacije za recepte svojega prostora.' : 'Preglejte oddane kopije receptov in odločite o objavi.' %></p></div></header>
<nav class="collection-tabs" aria-label="Zbirke receptov"><a href="/recipes">Moj prostor</a><a href="/community" <%- collectionScope === 'approved' ? 'aria-current="page"' : '' %>>Skupna kuharica</a><a href="/submissions" <%- collectionScope === 'mine' ? 'aria-current="page"' : '' %>>Naše oddaje</a><% if (user.isModerator) { %><a href="/admin/reviews" <%- collectionScope === 'reviews' ? 'aria-current="page"' : '' %>>Pregled oddaj</a><% } %></nav>
<form method="get" action="<%= base %>" class="filters"><label>Ime recepta<input type="search" name="q" maxlength="160" value="<%= typeof query.q === 'string' ? query.q : '' %>"></label><% if (collectionScope === 'approved') { %><label class="checkbox-label"><input type="checkbox" name="favorite" value="1" <%= query.favorite === '1' ? 'checked' : '' %>> Moji priljubljeni</label><% } %><button class="button">Poišči</button><a class="text-link" href="<%= base %>">Počisti</a></form><p class="result-count muted"><%= count %> receptov</p>
<% if (items.length) { %><div class="recipe-grid"><% items.forEach(item => { %><%- include('../components/card', { recipe: { ...item.recipe, id: item.id, communityId: item.id, status: item.status, favorite: item.favorite } }) %><% }); %></div><nav class="pagination" aria-label="Strani skupne kuharice"><% for (const [p,label] of [[page-1,'← Prejšnja'],[page+1,'Naslednja →']]) { if (p >= 1 && p <= pages) { const parameters = new URLSearchParams(); if (typeof query.q === 'string') parameters.set('q',query.q); if (query.favorite === '1') parameters.set('favorite','1'); parameters.set('page',p); %><a class="button secondary" href="<%= base + '?' + parameters.toString() %>"><%= label %></a><% } } %><% if (pages > 1) { %><span><%= page %> / <%= pages %></span><% } %></nav><% } else { %><div class="empty-state"><span aria-hidden="true">♧</span><h2>Prostor za nove okuse.</h2><p><%= collectionScope === 'reviews' ? 'Trenutno ni receptov za pregled.' : collectionScope === 'mine' ? 'Še ni oddaj. Odprite objavljen recept v svojem prostoru in ga pošljite v pregled.' : 'Za te pogoje še ni odobrenih receptov.' %></p></div><% } %><%- include('../layouts/footer') %>
