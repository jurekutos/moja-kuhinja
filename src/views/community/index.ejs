<%- include('../layouts/header') %><header class="page-header"><div><p class="eyebrow"><%= t("community:s58509a549df0") %></p><h1><%= title %></h1><p class="muted"><%= collectionScope === 'approved' ? t("community:sd5a5a242d275") : collectionScope === 'mine' ? t('common:submissionHelp') : t("community:sf6b143b4c6ce") %></p></div></header>
<nav class="collection-tabs" aria-label="<%= t("community:s886909bc4ce5") %>"><a href="/recipes"><%= t("community:sd62e71a971f6") %></a><a href="/community" <%- collectionScope === 'approved' ? 'aria-current="page"' : '' %>><%= t("community:s454cea33a66c") %></a><a href="/submissions" <%- collectionScope === 'mine' ? 'aria-current="page"' : '' %>><%= t("community:s55af0b7c729c") %></a><% if (user.isModerator) { %><a href="/admin/reviews" <%- collectionScope === 'reviews' ? 'aria-current="page"' : '' %>><%= t("community:sd46d260554dc") %></a><% } %></nav>
<form method="get" action="<%= base %>" class="filters"><label><%= t("community:sa38f76822498") %><input type="search" name="q" maxlength="160" value="<%= typeof query.q === 'string' ? query.q : '' %>"></label><% if (collectionScope === 'approved') { %><label class="checkbox-label"><input type="checkbox" name="favorite" value="1" <%= query.favorite === '1' ? 'checked' : '' %>> <%= t("community:sed901324b206") %></label><% } %><button class="button"><%= t("community:sc808f4beba2d") %></button><a class="text-link" href="<%= base %>"><%= t("community:s4b9c8d149601") %></a></form><p class="result-count muted"><%= count %> <%= t("community:s7b9e77380ca6") %></p>
<% if (items.length) { %><div class="recipe-grid"><% items.forEach(item => { %><%- include('../components/card', { recipe: { ...item.recipe, id: item.id, communityId: item.id, status: item.status, favorite: item.favorite, reviewLanguage:collectionScope!=='approved'?item.language:null } }) %><% }); %></div><nav class="pagination" aria-label="<%= t("community:s393a770f4887") %>"><% for (const [p,label] of [[page-1,t("community:s579258446055")],[page+1,t("community:s051dd8e9285b")]]) { if (p >= 1 && p <= pages) { const parameters = new URLSearchParams(); if (typeof query.q === 'string') parameters.set('q',query.q); if (query.favorite === '1') parameters.set('favorite','1'); parameters.set('page',p); %><a class="button secondary" href="<%= base + '?' + parameters.toString() %>"><%= label %></a><% } } %><% if (pages > 1) { %><span><%= page %> / <%= pages %></span><% } %></nav><% } else { %><div class="empty-state"><span aria-hidden="true">♧</span><h2><%= t("community:s1e6f40c5ff9a") %></h2><p><%= collectionScope === 'reviews' ? t("community:sdd9169b3ec8a") : collectionScope === 'mine' ? t("community:sddc35e3952ff") : t("community:s5a7c343c4ced") %></p></div><% } %><%- include('../layouts/footer') %>
