<!doctype html>
<html lang="<%= language %>"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="mk-translations" content="<%= JSON.stringify(browserMessages) %>"><meta name="theme-color" content="#304237"><title><%= seo ? seo.title : title + ' · Moja kuhinja' %></title><%- include('../components/seo') %><link rel="icon" href="<%= localeUrl("/icons/leaf.svg") %>" type="image/svg+xml"><link rel="stylesheet" href="<%= localeUrl("/css/app.css") %>"><script type="module" src="<%= localeUrl("/js/app.js") %>"></script></head>
<body><a class="skip-link" href="#main"><%= t("common:s36376f417ea0") %></a>
<% if (!user && !publicWebsite) { %><div class="page-language-bar"><%- include('../components/language-picker') %></div><% } %>
<% if (user && !publicWebsite) { %><aside class="sidebar"><a class="brand" href="<%= localeUrl("/") %>"><span class="brand-icon">m.</span><span>moja kuhinja<small><%= t("common:se0e84c004561") %></small></span></a><p class="eyebrow nav-label"><%= t("common:sbd948a95027e") %></p><nav aria-label="<%= t("common:sb2414ec80c18") %>"><% for (const [url,label,icon] of [['/',t("common:s2402237814d8"),'⌂'],['/recipes',t("common:s1ad7bccda1ea"),'▤'],['/planner',t("common:s0cbd21357048"),'▦'],['/shopping',t("common:scbb9922e21c4"),'♧']]) { %><a class="nav-item <%= path === url || url !== '/' && path.startsWith(url + '/') ? 'active' : '' %>" href="<%= localeUrl((url)) %>"><span aria-hidden="true"><%= icon %></span><%= label %><% if (url === '/shopping') { %><small><%= t("common:s8881d7a20148") %></small><% } %></a><% } %></nav><div class="household"><span class="avatar"><%= user.name.charAt(0).toUpperCase() %></span><div><strong><%= user.name %></strong><div class="profile-menu"><a class="text-link" href="<%= localeUrl("/settings") %>"><%= t("common:s35e2ed99f9ee") %></a></div><small><%= user.householdName %></small></div><form action="<%= localeUrl("/logout") %>" method="post"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="icon-button" aria-label="<%= t("common:sa0b33286dccb") %>" title="<%= t("common:sa0b33286dccb") %>">↪</button></form></div></aside><% } %>
<main id="main" class="<%= publicWebsite ? 'public-shell' : user ? 'main-shell' : 'auth-shell' %>"><% if (publicWebsite) { %><%- include('../components/public-header') %><% } %><% if (user && !publicWebsite) { %><%- include('../components/workspace-toolbar') %><% } %><% if (flash) { %><div class="notice" role="status"><%= flash %></div><% } %>
