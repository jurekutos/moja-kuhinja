<!doctype html>
<html lang="sl"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="theme-color" content="#304237"><title><%= title %> · Moja kuhinja</title><link rel="icon" href="/icons/leaf.svg" type="image/svg+xml"><link rel="stylesheet" href="/css/app.css"><script type="module" src="/js/app.js"></script></head>
<body><a class="skip-link" href="#main">Preskoči na vsebino</a>
<% if (user) { %><aside class="sidebar"><a class="brand" href="/"><span class="brand-icon">m.</span><span>moja kuhinja<small>Dobro je biti doma.</small></span></a><p class="eyebrow nav-label">VAŠ KUHARSKI KOTIČEK</p><nav aria-label="Glavna navigacija"><% for (const [url,label,icon] of [['/','Domov','⌂'],['/recipes','Recepti','▤'],['/planner','Jedilnik','▦'],['/shopping','Nakupi','♧']]) { %><a class="nav-item <%= path === url || url !== '/' && path.startsWith(url + '/') ? 'active' : '' %>" href="<%= url %>"><span aria-hidden="true"><%= icon %></span><%= label %><% if (url === '/shopping') { %><small>Kmalu</small><% } %></a><% } %></nav><div class="household"><span class="avatar"><%= user.name.charAt(0).toUpperCase() %></span><div><strong><%= user.name %></strong><small><%= user.householdName %></small></div><form action="/logout" method="post"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="icon-button" aria-label="Odjava" title="Odjava">↪</button></form></div></aside><% } %>
<main id="main" class="<%= user ? 'main-shell' : 'auth-shell' %>"><% if (user) { %><%- include('../components/workspace-toolbar') %><% } %><% if (flash) { %><div class="notice" role="status"><%= flash %></div><% } %>
