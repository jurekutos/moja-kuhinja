<%- include('../layouts/header') %><header class="page-header"><div><p class="eyebrow"><%= t("settings:sfe7297c87594") %></p><h1><%= t("settings:s35e2ed99f9ee") %></h1><p class="muted"><%= t("settings:s278ea64bb790") %></p></div></header>
<% if(errors.length){ %><div class="errors" role="alert"><% errors.forEach(error=>{ %><p><%= error %></p><% }); %></div><% } %>
<div class="settings-columns"><section class="panel stack"><h2><%= t("settings:sd41ede7c8dd5") %></h2><label><%= t("settings:s1a14ac1e9352") %><input value="<%= profile.email %>" type="email" readonly></label><small class="muted"><%= t("settings:sbaebad146383") %></small><p class="small muted"><%= t("settings:s56b2759ecd05") %> <%= profile.createdAt ? new Date(profile.createdAt).toLocaleDateString(locale,{timeZone:'Europe/Ljubljana'}) : t("settings:sb659c6473135") %></p><form action="/settings/profile" method="post" class="stack"><input type="hidden" name="_csrf" value="<%= csrf %>"><label><%= t("settings:s9a9c04175284") %><input name="name" value="<%= profile.name %>" required maxlength="100" autocomplete="name"></label><div><button class="button"><%= t("settings:s577804d3a711") %></button></div></form></section>
<section class="panel stack"><h2><%= t("settings:s40291010cf9b") %></h2><p class="small muted"><%= t("settings:sad3fcacc64b1") %></p><form action="/settings/password" method="post" class="stack"><input type="hidden" name="_csrf" value="<%= csrf %>"><label><%= t("settings:sba07f1377ad6") %><input type="password" name="currentPassword" required maxlength="1024" autocomplete="current-password"></label><label><%= t("settings:s61fa6c7c846a") %><input type="password" name="newPassword" required minlength="8" maxlength="1024" autocomplete="new-password"></label><label><%= t("settings:s267d5a4413a6") %><input type="password" name="confirmation" required minlength="8" maxlength="1024" autocomplete="new-password"></label><small class="muted"><%= t("settings:sd96857f0fe87") %></small><div><button class="button"><%= t("settings:s40291010cf9b") %></button></div></form></section></div>
<section class="panel stack"><h2><%= t("settings:s1154fa98c18c") %></h2><% if(!memberships.length){ %><p class="muted"><%= t("settings:sb18a2d143658") %></p><a class="text-link" href="/community"><%= t("settings:s2ab52f23b9f3") %></a><% } %><% memberships.forEach(space=>{ %><article class="member-row"><div><h3><%= space.name %></h3><p class="small muted"><%= ({admin:t("settings:s7246e87eb0ab"),editor:t("settings:s5f93461e96bf"),viewer:t("settings:sbc6f98e47b3d")})[space.role] %> <%= t("settings:s082fed88ca26") %> <%= space.memberCount %><%= space.householdId===user.householdId?t('common:currentWorkspace'):'' %></p></div><div class="actions"><form action="/workspace/switch" method="post"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="householdId" value="<%= space.householdId %>"><% if(space.role==='admin'){ %><input type="hidden" name="destination" value="/workspace"><% } %><button class="button secondary"><%= space.role==='admin'?t("settings:s0e114a0e2aae"):t("settings:s74209baf0755") %></button></form><a class="text-link danger" href="/workspaces/<%= space.householdId %>/leave"><%= t("settings:saad8662cfc9d") %></a></div></article><% }); %></section><%- include('../layouts/footer') %>
