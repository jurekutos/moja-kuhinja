<%- include('../layouts/header') %><header class="page-header"><div><p class="eyebrow">VAŠ OSEBNI KOTIČEK</p><h1>Moj profil</h1><p class="muted">Podatki računa, varnost in vaši kuharski prostori.</p></div></header>
<% if(errors.length){ %><div class="errors" role="alert"><% errors.forEach(error=>{ %><p><%= error %></p><% }); %></div><% } %>
<div class="settings-columns"><section class="panel stack"><h2>Podatki računa</h2><label>E-poštni naslov<input value="<%= profile.email %>" type="email" readonly></label><small class="muted">E-poštnega naslova ni mogoče spremeniti.</small><p class="small muted">Registracija: <%= profile.createdAt ? new Date(profile.createdAt).toLocaleDateString('sl-SI') : 'Datum ni zabeležen' %></p><form action="/settings/profile" method="post" class="stack"><input type="hidden" name="_csrf" value="<%= csrf %>"><label>Prikazno ime<input name="name" value="<%= profile.name %>" required maxlength="100" autocomplete="name"></label><div><button class="button">Shrani ime</button></div></form></section>
<section class="panel stack"><h2>Spremeni geslo</h2><p class="small muted">Po spremembi bodo druge prijave odjavljene. Ta prijava bo varno obnovljena.</p><form action="/settings/password" method="post" class="stack"><input type="hidden" name="_csrf" value="<%= csrf %>"><label>Trenutno geslo<input type="password" name="currentPassword" required maxlength="1024" autocomplete="current-password"></label><label>Novo geslo<input type="password" name="newPassword" required minlength="8" maxlength="1024" autocomplete="new-password"></label><label>Ponovite novo geslo<input type="password" name="confirmation" required minlength="8" maxlength="1024" autocomplete="new-password"></label><small class="muted">Najmanj 8 znakov.</small><div><button class="button">Spremeni geslo</button></div></form></section></div>
<section class="panel stack"><h2>Moji prostori</h2><% if(!memberships.length){ %><p class="muted">Trenutno niste član nobenega prostora. Vaš račun ostaja aktiven. Za pridružitev odprite veljavno povabilo.</p><a class="text-link" href="/community">Razišči skupno kuharico →</a><% } %><% memberships.forEach(space=>{ %><article class="member-row"><div><h3><%= space.name %></h3><p class="small muted"><%= ({admin:'Skrbnik',editor:'Urednik',viewer:'Samo branje'})[space.role] %> · Člani: <%= space.memberCount %><%= space.householdId===user.householdId?' · Trenutni prostor':'' %></p></div><div class="actions"><form action="/workspace/switch" method="post"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="householdId" value="<%= space.householdId %>"><% if(space.role==='admin'){ %><input type="hidden" name="destination" value="/workspace"><% } %><button class="button secondary"><%= space.role==='admin'?'Odpri in upravljaj':'Preklopi v prostor' %></button></form><a class="text-link danger" href="/workspaces/<%= space.householdId %>/leave">Zapusti prostor</a></div></article><% }); %></section><%- include('../layouts/footer') %>
