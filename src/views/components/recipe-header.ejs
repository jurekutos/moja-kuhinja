<header class="page-header">
  <div>
    <div class="tags"><% recipe.categories.forEach(c => { %><span><%= c %></span><% }); %><% if (recipe.status === 'draft') { %><span>Osnutek</span><% } %></div>
    <h1><%= recipe.title %></h1>
    <p class="small muted recipe-author">Avtor: <a class="text-link" href="/recipes?view=workspace&amp;author=<%= recipe.createdBy %>"><%= recipe.authorName %></a></p>
    <p class="small muted">Dodano <%= new Date(recipe.createdAt).toLocaleDateString('sl-SI', { timeZone: 'Europe/Ljubljana' }) %> · Posodobljeno <%= new Date(recipe.updatedAt).toLocaleDateString('sl-SI', { timeZone: 'Europe/Ljubljana' }) %></p>
    <p class="muted preserve"><%= recipe.description %></p>
  </div>
  <% if (!cooking) { %><div class="recipe-header-tools">
    <div class="actions">
      <form action="/recipes/<%= recipe.id %>/favorite" method="post"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="button secondary" aria-pressed="<%= recipe.favorite %>"><%= recipe.favorite ? '♥ Priljubljen' : '♡ Med priljubljene' %></button></form>
      <% if (user.role !== 'viewer' && recipe.createdBy === user.id) { %>
        <a class="button secondary" href="/recipes/<%= recipe.id %>/edit">Uredi</a>
        <form action="/recipes/<%= recipe.id %>/delete" method="post" data-confirm="Res izbrišem recept in vse njegove slike? Tega ni mogoče razveljaviti."><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="button secondary danger">Izbriši recept</button></form>
      <% } %>
      <a class="button" data-cook-link href="/recipes/<%= recipe.id %>/cook">Začni kuhati →</a>
    </div>
  </div><% } %>
</header>
