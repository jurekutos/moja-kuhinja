<article class="recipe-card"><a class="card-image" href="<%= localeUrl(recipe.href) %>" aria-label="<%= recipe.title %>"><% if(recipe.images.length){ %><img src="<%= localeUrl(recipe.images[0].thumbnail) %>" srcset="<%= localeUrl(recipe.images[0].thumbnail) %> 600w, <%= localeUrl(recipe.images[0].url) %> 1600w" sizes="(max-width:760px) 100vw, (max-width:1100px) 50vw, 400px" alt="<%= recipe.title %>" width="600" height="450" loading="lazy"><% }else{ %><div class="food-placeholder"><span aria-hidden="true">♧</span><small><%= t('public:photoPlaceholder') %></small></div><% } %></a><% if(user){ %><form class="card-heart" method="post" action="<%= localeUrl('/community/'+recipe.id+'/favorite') %>"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="returnTo" value="<%= path==='/community'?returnTo:'/welcome' %>"><button class="heart-button" aria-pressed="<%= recipe.favorite %>" aria-label="<%= recipe.favorite?t('common:sc3eacd2b6c18'):t('common:s10c559a1c494') %>"><span aria-hidden="true"><%= recipe.favorite?'♥':'♡' %></span></button></form><% } %><div class="card-content"><div class="tags"><span><%= recipe.language.toUpperCase() %></span><% recipe.categories.slice(0,2).forEach(category=>{ %><span><%= category.name %></span><% }); %></div><h3><a href="<%= localeUrl(recipe.href) %>"><%= recipe.title %></a></h3><p class="small muted"><%= recipe.prepMinutes!==null && recipe.cookMinutes!==null ? recipe.prepMinutes+recipe.cookMinutes+' min' : t('public:timeUnavailable') %><% if(recipe.servings!==null){ %> · <%= recipe.servings %> <%= t('public:servings') %><% } %></p></div></article>
