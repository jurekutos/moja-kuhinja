<div class="workspace-toolbar"><% if(workspaces.length){ %><form method="post" action="<%= localeUrl("/workspace/switch") %>" class="workspace-switch"><input type="hidden" name="_csrf" value="<%= csrf %>"><label for="workspace-select"><%= t("common:sd62e71a971f6") %></label><select id="workspace-select" name="householdId"><% workspaces.forEach(space => { %><option value="<%= space.householdId %>" <%= space.householdId === user.householdId ? 'selected' : '' %>><%= space.householdName %></option><% }); %></select><% if (workspaces.length > 1) { %><button class="text-link"><%= t("common:sd24697fb6a4d") %></button><% } %></form><% } else { %><span class="muted small"><%= t("common:sc6ce2878e989") %></span><% } %><nav class="actions" aria-label="<%= t("common:s89a9ee355a5b") %>"><a class="text-link" href="<%= localeUrl("/community") %>"><%= t("common:s454cea33a66c") %></a><a class="text-link" href="<%= localeUrl("/workspace") %>"><%= t("common:s0114df664eb7") %></a><% if (user.isModerator) { %><a class="text-link" href="<%= localeUrl("/admin/invitations") %>"><%= t("common:saa12975d7062") %></a><a class="text-link" href="<%= localeUrl("/admin/reviews") %>"><%= t("common:sd46d260554dc") %></a><% } %><% if(user.isSuperAdmin){ %><a class="text-link" href="<%= localeUrl("/super-admin") %>"><%= t("common:s154021b100f0") %></a><% } %></nav></div>
