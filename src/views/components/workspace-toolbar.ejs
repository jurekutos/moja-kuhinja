<div class="workspace-toolbar"><% if(workspaces.length){ %><form method="post" action="/workspace/switch" class="workspace-switch"><input type="hidden" name="_csrf" value="<%= csrf %>"><label for="workspace-select">Moj prostor</label><select id="workspace-select" name="householdId"><% workspaces.forEach(space => { %><option value="<%= space.householdId %>" <%= space.householdId === user.householdId ? 'selected' : '' %>><%= space.householdName %></option><% }); %></select><% if (workspaces.length > 1) { %><button class="text-link">Preklopi</button><% } %></form><% } else { %><span class="muted small">Brez aktivnega prostora</span><% } %><nav class="actions" aria-label="Prostori in skupnost"><a class="text-link" href="/community">Skupna kuharica</a><a class="text-link" href="/workspace">Člani in prostor</a><% if (user.isModerator) { %><a class="text-link" href="/admin/invitations">Povabi prijatelje</a><a class="text-link" href="/admin/reviews">Pregled oddaj</a><% } %><% if(user.isSuperAdmin){ %><a class="text-link" href="/super-admin">Upravljanje platforme</a><% } %></nav></div>
