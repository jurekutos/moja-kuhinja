<% const base = recipe.communityId ? '/community' : '/recipes'; %>
<article class="recipe-card"><a class="card-image" href="<%= localeUrl((base) + "/" + (recipe.id) + (recipe.reviewLanguage ? '?reviewLanguage=' + recipe.reviewLanguage : '')) %>" aria-label="<%= recipe.title %>">
<% if (recipe.images.length) { %><img src="<%= localeUrl((recipe.communityId ? '/community/' + recipe.id + '/images/0' : '/images/' + recipe.images[0].id) + "?size=small" + (recipe.reviewLanguage ? '&reviewLanguage=' + recipe.reviewLanguage : '')) %>" alt="<%= recipe.title %>" width="600" height="450" loading="lazy"><% } else { %><div class="food-placeholder"><span aria-hidden="true">♧</span><small><%= t("common:sd650e086225f") %></small></div><% } %>
<% if (['draft','pending','rejected'].includes(recipe.status)) { %><span class="image-badge"><%= ({draft:t("common:sa4cf485f8f37"),pending:t('common:pending'),rejected:t("common:s19ccdf36c5cc")})[recipe.status] %></span><% } %></a>
<% if (!recipe.communityId || recipe.status === 'approved') { %><form class="card-heart" action="<%= localeUrl((base) + "/" + (recipe.id) + "/favorite") %>" method="post"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="returnTo" value="<%= returnTo %>"><button type="submit" class="heart-button" aria-pressed="<%= recipe.favorite %>" aria-label="<%= recipe.favorite ? t("common:sc817c1255791") : t("common:sf2b45139f3b1") %><%= recipe.title %>" title="<%= recipe.favorite ? t("common:sc3eacd2b6c18") : t("common:s10c559a1c494") %>"><span aria-hidden="true"><%= recipe.favorite ? '♥' : '♡' %></span></button></form><% } %>
<div class="card-content"><% if (typeof view !== 'undefined' && view === 'all') { %><p class="small muted"><%= recipe.communityId ? t("common:s8960603fb182") : t("common:sd62e71a971f6") %><% if(!recipe.communityId && recipe.publicPublicationId){ %> · <%= t('common:alsoPublic') %><% } %></p><% } %><div class="tags"><span title="<%= t('common:recipeLanguage') + ': ' + localeNames[recipe.language || recipe.reviewLanguage || language] %>"><%= (recipe.language || recipe.reviewLanguage || language).toUpperCase() %></span><% recipe.categories.slice(0,2).forEach(c => { %><span><%= c %></span><% }); %></div><h3><a href="<%= localeUrl((base) + "/" + (recipe.id) + (recipe.reviewLanguage ? "?reviewLanguage=" + recipe.reviewLanguage : "")) %>"><%= recipe.title %></a></h3><p class="muted">◷ <%= recipe.prepMinutes + recipe.cookMinutes %> <%= t("common:seb8368e0da20") %> <%= recipe.servings %> <%= t("common:sb65ac01bc4c7") %></p><% if(!recipe.communityId && recipe.publicPublicationId){ %><a class="text-link small" href="<%= localeUrl('/community/'+recipe.publicPublicationId) %>"><%= t('common:viewPublicVersion') %></a><% } %></div></article>
