<% const base = recipe.communityId ? '/community' : '/recipes'; %>
<article class="recipe-card"><a class="card-image" href="<%= base %>/<%= recipe.id %>" aria-label="<%= recipe.title %>">
<% if (recipe.images.length) { %><img src="<%= recipe.communityId ? '/community/' + recipe.id + '/images/0' : '/images/' + recipe.images[0].id %>?size=small" alt="<%= recipe.title %>" width="600" height="450" loading="lazy"><% } else { %><div class="food-placeholder"><span aria-hidden="true">♧</span><small>Prostor za nekaj okusnega</small></div><% } %>
<% if (['draft','pending','rejected'].includes(recipe.status)) { %><span class="image-badge"><%= ({draft:'Osnutek',pending:'V pregledu',rejected:'Zavrnjeno'})[recipe.status] %></span><% } %></a>
<% if (!recipe.communityId || recipe.status === 'approved') { %><form class="card-heart" action="<%= base %>/<%= recipe.id %>/favorite" method="post"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="returnTo" value="<%= returnTo %>"><button type="submit" class="heart-button" aria-pressed="<%= recipe.favorite %>" aria-label="<%= recipe.favorite ? 'Odstrani iz priljubljenih: ' : 'Dodaj med priljubljene: ' %><%= recipe.title %>" title="<%= recipe.favorite ? 'Odstrani iz priljubljenih' : 'Dodaj med priljubljene' %>"><span aria-hidden="true"><%= recipe.favorite ? '♥' : '♡' %></span></button></form><% } %>
<div class="card-content"><% if (typeof view !== 'undefined' && view === 'all') { %><p class="small muted"><%= recipe.communityId ? 'Javni recept' : 'Moj prostor' %></p><% } %><div class="tags"><% recipe.categories.slice(0,2).forEach(c => { %><span><%= c %></span><% }); %></div><h3><a href="<%= base %>/<%= recipe.id %>"><%= recipe.title %></a></h3><p class="muted">◷ <%= recipe.prepMinutes + recipe.cookMinutes %> min · <%= recipe.servings %> porcij</p></div></article>
