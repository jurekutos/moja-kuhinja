<% if (user.role !== 'viewer' && recipe.status === 'published') { %><section class="<%= typeof compact !== 'undefined' && compact ? 'stack' : 'panel stack' %>"><% if (typeof compact === 'undefined' || !compact) { %><h2><%= t("common:s4f0406d5a284") %></h2><% } %><p class="muted"><%= t("common:s4d9ba05ed128") %></p><form method="post" class="stack" action="<%= localeUrl("/recipes/" + (recipe.id) + "/submit") %>" data-confirm="<%= t("common:s2dced00a3e04") %>"><input type="hidden" name="_csrf" value="<%= csrf %>"><% if (typeof sharingReturnTo === 'string') { %><input type="hidden" name="returnTo" value="<%= sharingReturnTo %>"><% } %><label><%= t('common:publicLanguage') %><select name="language"><% recipe.translations.filter(v=>v.complete&&v.reviewed).forEach(version=>{ %><option value="<%= version.language %>" <%= version.language===recipe.language?'selected':'' %>><%= localeNames[version.language] %></option><% }); %></select></label><fieldset><legend><%= t('common:globalMapping') %></legend><p class="small muted"><%= t('common:mappingHelp') %></p><% globalCategories.forEach(category=>{ %><label class="checkbox-label"><input type="checkbox" name="categoryIds" value="<%= category.id %>"><%= category.name %></label><% }); %></fieldset><button class="button secondary" name="intent" value="draft"><%= t('common:savePublicationDraft') %></button><button class="button secondary"><%= t("common:s914db294c3d7") %></button></form><a href="<%= localeUrl("/submissions") %>" class="text-link"><%= t("common:s73524b4c75b2") %></a></section><% } %>
