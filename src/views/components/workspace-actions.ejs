<section class="panel stack"><h2>Moje članstvo</h2><p class="muted">Vse prostore in svoje vloge najdete v osebnih nastavitvah.</p><div class="actions"><a class="button secondary" href="/settings">Moji prostori in profil</a><a class="text-link danger" href="/workspaces/<%= user.householdId %>/leave">Zapusti prostor</a></div></section>
<% if(user.role==='admin'){ %><section class="panel stack"><h2>Upravljanje prostora</h2><form action="/workspace/rename" method="post" class="stack"><input type="hidden" name="_csrf" value="<%= csrf %>"><label>Ime prostora<input name="name" value="<%= user.householdName %>" required maxlength="100"></label><div><button class="button secondary">Preimenuj prostor</button></div></form><hr><p class="small danger">Izbris prostora je trajen. Vsi člani izgubijo dostop do njegovih podatkov.</p><div><a class="button danger-button" href="/workspace/delete">Izbriši prostor</a></div></section><% } %>
