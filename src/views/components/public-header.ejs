<header class="public-header">
  <a class="brand" href="<%= localeUrl('/welcome') %>"><span class="brand-icon">m.</span><span>moja kuhinja</span></a>
  <nav class="actions" aria-label="<%= t('public:navigation') %>"><a class="text-link" href="<%= localeUrl('/community') %>"><%= t('public:explore') %></a><a class="text-link" href="<%= localeUrl('/welcome#how') %>"><%= t('public:features') %></a><% if(user){ %><a class="button secondary" href="<%= localeUrl('/kitchen') %>"><%= t('public:myKitchen') %></a><% }else{ %><a class="text-link" href="<%= localeUrl('/login') %>"><%= t('public:login') %></a><a class="button" href="<%= localeUrl('/register') %>"><%= t('public:createAccount') %></a><% } %></nav>
  <nav class="public-languages actions" aria-label="<%= t('common:language') %>"><% const languageLinks=languages.map(code=>seo?.alternates?.find(item=>item.language===code)||({language:code,path:'/'+code+'/community'}));languageLinks.forEach(alternate=>{ %><a href="<%= alternate.path %>" lang="<%= alternate.language %>" hreflang="<%= alternate.language %>" <%- alternate.language===language?'aria-current="page"':'' %>><%= alternate.language.toUpperCase() %></a><% }); %></nav>
</header>
