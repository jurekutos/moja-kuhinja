<section class="language-indicator"><p class="small muted"><%= t('common:recipeLanguage') %>: <strong><%= localeNames[recipe.language] %></strong><% if(recipe.fallback){ %> · <%= t('common:originalFallback') %><% } %></p>
<nav class="actions" aria-label="<%= t('common:translations') %>"><% recipe.translations.filter(v=>v.complete).forEach(version=>{ %><a class="text-link" href="/recipes/<%= recipe.id %><%= cooking?'/cook':'' %>?lang=<%= version.language %>"><%= localeNames[version.language] %></a><% }); %></nav>
<% if(recipe.createdBy===user.id && user.role!=='viewer'){ %><div class="actions"><% languages.filter(l=>l!==recipe.originalLanguage).forEach(code=>{const version=recipe.translations.find(v=>v.language===code); %><a class="text-link" href="/recipes/<%= recipe.id %>/translations/<%= code %>"><%= t('common:addTranslation') %> · <%= localeNames[code] %><% if(version){ %> (<%= version.complete&&version.reviewed?t('common:reviewed'):t('common:draft') %>)<% } %></a><% }); %></div><% } %></section>
