<div class="stack"><% invitations.forEach(invitation => { %><div class="member-row"><div><strong><%= invitation.email %></strong><p class="small muted"><%= invitation.usedAt ? 'Sprejeto' : invitation.revokedAt ? 'Preklicano' : invitation.expiresAt <= Date.now() ? 'Poteklo' : 'Čaka na sprejem' %> · Velja do <%= new Date(invitation.expiresAt).toLocaleDateString('sl-SI') %></p></div><% if (!invitation.usedAt && !invitation.revokedAt && invitation.expiresAt > Date.now()) { %><form method="post" action="<%= invitation.householdId ? '/workspace/invitations/' : '/admin/invitations/' %><%= invitation.id %>/revoke"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="text-link danger">Prekliči povabilo</button></form><% } %></div><% }); %><% if (!invitations.length) { %><p class="muted">Še ni povabil.</p><% } %></div>
