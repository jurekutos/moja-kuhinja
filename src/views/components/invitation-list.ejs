<div class="stack"><% invitations.forEach(invitation => { %><div class="member-row"><div><strong><%= invitation.email %></strong><p class="small muted"><%= invitation.usedAt ? t("common:s5729bffa7759") : invitation.revokedAt ? t("common:sa7ef150c5524") : invitation.expiresAt <= Date.now() ? t("common:sacd718a9a33a") : t("common:scffe4666a3d7") %> <%= t("common:s4e9773a801a4") %> <%= new Date(invitation.expiresAt).toLocaleDateString(locale,{timeZone:'Europe/Ljubljana'}) %></p></div><% if (!invitation.usedAt && !invitation.revokedAt && invitation.expiresAt > Date.now()) { %><form method="post" action="<%= localeUrl((invitation.householdId ? '/workspace/invitations/' : '/admin/invitations/') + (invitation.id) + "/revoke") %>"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="text-link danger"><%= t("common:s858626593961") %></button></form><% } %></div><% }); %><% if (!invitations.length) { %><p class="muted"><%= t("common:sfed35c2d1c66") %></p><% } %></div>
