<section class="panel stack" id="ingredient-section"><div class="section-heading"><div><h2><%= t("recipes:s49527351414c") %></h2><p class="muted small"><%= t("recipes:sc6081842e408") %></p></div></div><input type="hidden" name="ingredientsJson" id="ingredients-json" value="<%= JSON.stringify(recipe.ingredients.map(i => ({ canonicalIngredientId:i.canonicalIngredientId || null, name: i.name, quantity: i.quantity ?? '', unit: i.unit, note: i.note }))) %>"><div id="ingredient-rows"></div><datalist id="units"><% ['g','kg','ml','l','piece','tablespoon','teaspoon'].forEach(u => { %><option value="<%= u %>"><%= unitLabel(u) %></option><% }); %></datalist><button type="button" id="add-ingredient" class="button secondary"><%= t("recipes:s0b307a8aff1a") %></button></section>
<section class="panel stack"><h2><%= t("recipes:sb95c5bf44b2c") %></h2><p class="muted small"><%= t("recipes:s8262c80e46a1") %></p><input type="hidden" name="stepsJson" id="steps-json" value="<%= JSON.stringify(recipe.steps) %>"><div id="step-rows"></div><button type="button" class="button secondary" id="add-step"><%= t("recipes:s2c148e1043be") %></button></section>
