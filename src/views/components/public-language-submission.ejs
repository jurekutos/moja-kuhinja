<% if(publication.householdId===user.householdId && user.role!=='viewer' && publication.recipeId){ %><section class="panel stack"><h2><%= t('common:submitTranslation') %></h2><form class="stack" method="post" action="<%= localeUrl("/community/" + (publication.id) + "/languages") %>"><input type="hidden" name="_csrf" value="<%= csrf %>"><% publication.categoryIds.forEach(id=>{ %><input type="hidden" name="categoryIds" value="<%= id %>"><% }); %><label><%= t('common:publicLanguage') %><select name="language"><% publication.translationOptions.forEach(v=>{ %><option value="<%= v.language %>"><%= localeNames[v.language] %></option><% }); %></select></label><button class="button secondary" name="intent" value="draft"><%= t('common:savePublicationDraft') %></button><button class="button secondary"><%= t('common:submitTranslation') %></button></form></section><% } %>

<% if(publication.status==='draft' && publication.householdId===user.householdId && user.role!=='viewer'){ %><form class="panel" method="post" action="<%= localeUrl("/community/" + (publication.id) + "/submit-draft") %>"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="language" value="<%= publication.language %>"><button class="button"><%= t('common:submitDraft') %></button></form><% } %>
