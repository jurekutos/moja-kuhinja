<section class="panel stack comments-panel" id="comments" aria-labelledby="comments-heading">
  <div><p class="eyebrow"><%= t("common:sbc32f66b33bb") %></p><h2 id="comments-heading"><%= t("common:se9a437950c46") %><%= comments.length %>)</h2><p class="muted small"><%= t("common:s6d4f49c568ce") %></p></div>
  <% if (comments.length) { %>
    <ol class="comment-list"><% comments.forEach(comment => { %>
      <li class="comment-item"><div class="comment-meta"><strong><%= comment.author %></strong><time class="muted small" datetime="<%= comment.createdAt %>"><%= new Date(comment.createdAt).toLocaleString(locale, { timeZone: 'Europe/Ljubljana', dateStyle: 'medium', timeStyle: 'short' }) %></time></div>
        <p class="preserve"><%= comment.body %></p>
        <% if (comment.userId === user.id) { %><form action="<%= localeUrl("/recipes/" + (recipe.id) + "/comments/" + (comment.id) + "/delete") %>" method="post" data-confirm="<%= t("common:sc7bbac200a9b") %>"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="text-link danger" aria-label="<%= t("common:s0689fa5d3caf") %>"><%= t("common:s3cba11936251") %></button></form><% } %>
      </li>
    <% }); %></ol>
  <% } else { %><p class="muted"><%= t("common:s5ff1d585eee2") %></p><% } %>
  <form action="<%= localeUrl("/recipes/" + (recipe.id) + "/comments") %>" method="post" class="stack">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <label for="comment-body"><%= t("common:s61cbd86b9a32") %></label>
    <% if (commentError) { %><p id="comment-error" class="danger" role="alert"><%= commentError %></p><% } %>
    <textarea id="comment-body" name="body" rows="3" required maxlength="2000" placeholder="<%= t("common:s9ca0e99e14e7") %>" aria-describedby="comment-help<%= commentError ? ' comment-error' : '' %>" <%- commentError ? 'aria-invalid="true" autofocus' : '' %>><%= commentBody %></textarea>
    <small id="comment-help" class="muted"><%= t("common:sf1fe99e44ab0") %></small>
    <div><button class="button"><%= t("common:s5b9c0171d628") %></button></div>
  </form>
</section>
