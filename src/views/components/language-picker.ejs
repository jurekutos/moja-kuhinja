<form action="/language" method="post" class="language-picker actions"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="returnTo" value="<%= path %>"><select name="language" aria-label="<%= t('common:language') %>"><% languages.forEach(code=>{ %><option value="<%= code %>" <%= language===code?'selected':'' %>><%= ({sl:'🇸🇮',en:'🇬🇧',de:'🇩🇪'})[code] %> <%= localeNames[code] %></option><% }); %></select><button class="button secondary"><%= t('common:saveLanguage') %></button></form>
