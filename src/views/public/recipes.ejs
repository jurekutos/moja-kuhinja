<%- include('../layouts/header') %><section class="public-content"><header class="page-header"><div><p class="eyebrow"><%= t('public:approvedCookbook') %></p><h1><%= t('public:directoryTitle') %></h1><p class="muted"><%= t('public:directoryDescription') %></p></div><% if(user){ %><a class="text-link" href="<%= localeUrl('/submissions') %>"><%= t('public:mySubmissions') %></a><% } %></header>
<form method="get" action="<%= localeUrl('/community') %>" class="filters"><label><%= t('public:recipeName') %><input type="search" name="q" maxlength="160" value="<%= query.q %>" placeholder="<%= t('public:searchPlaceholder') %>"></label><label><%= t('library:ingredientSearch') %><input name="ingredient" value="<%= query.ingredient %>" maxlength="150"></label><label><%= t('library:maxTime') %><select name="maxTime"><option value=""><%= t('library:allTimes') %></option><% ['15','30','60'].forEach(time=>{ %><option value="<%= time %>" <%= query.maxTime===time?'selected':'' %>><%= time %> min</option><% }); %></select></label><label><%= t('public:category') %><select name="category"><option value=""><%= t('public:allCategories') %></option><% categories.forEach(category=>{ %><option value="<%= category.key %>" <%= query.category===category.key?'selected':'' %>><%= category.name %></option><% }); %></select></label><label><%= t('public:sort') %><select name="sort"><option value="newest"><%= t('public:newest') %></option><option value="alpha" <%= query.sort==='alpha'?'selected':'' %>><%= t('public:alphabetical') %></option></select></label><% if(user){ %><label class="checkbox-label"><input type="checkbox" name="favorite" value="1" <%= query.favorite?'checked':'' %>><%= t('recipes:sed901324b206') %></label><% } %><button class="button"><%= t('public:search') %></button><a class="text-link" href="<%= localeUrl('/community') %>"><%= t('public:clear') %></a></form>
<p class="muted result-count"><%= count %> <%= t('public:recipesCount') %></p><% if(recipes.length){ %><div class="recipe-grid"><% recipes.forEach(recipe=>{ %><%- include('../components/public-card',{recipe}) %><% }); %></div><% }else{ %><div class="empty-state"><h2><%= t('public:emptyTitle') %></h2><p><%= t('public:emptyDescription') %></p></div><% } %>
<% if(pages>1){ %><nav class="pagination" aria-label="<%= t('public:pages') %>"><% if(page>1){ %><a class="button secondary" href="<%= localeUrl(pageLink(page-1)) %>"><%= t('public:previous') %></a><% } %><span><%= page %> / <%= pages %></span><% if(page<pages){ %><a class="button secondary" href="<%= localeUrl(pageLink(page+1)) %>"><%= t('public:next') %></a><% } %></nav><% } %></section><%- include('../layouts/footer') %>
