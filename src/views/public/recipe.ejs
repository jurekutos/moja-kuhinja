<%- include('../layouts/header') %><article class="public-content recipe-detail"><a class="back-link" href="<%= localeUrl('/community') %>">← <%= t('public:directoryTitle') %></a><% if(readCounts){ %><%- include('../components/read-counts',{readCounts}) %><% } %><header class="page-header"><div><div class="tags"><span><%= recipe.language.toUpperCase() %></span><% recipe.categories.forEach(category=>{ %><a href="<%= localeUrl('/community?category='+encodeURIComponent(category.key)) %>"><%= category.name %></a><% }); %></div><h1><%= recipe.title %></h1><p class="muted preserve"><%= recipe.description %></p><% if(recipe.author){ %><p class="small muted"><%= t('public:author') %>: <% if(recipe.authorHref){ %><a class="text-link" href="<%= localeUrl(recipe.authorHref) %>"><%= recipe.author %></a><% }else{ %><%= recipe.author %><% } %></p><% } %></div><div class="actions"><% if(user&&user.householdId&&user.role!=='viewer'){ %><form method="post" action="<%= localeUrl('/community/'+recipe.id+'/copy') %>"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="button"><%= t('public:saveRecipe') %></button></form><% }else if(!user){ %><a class="button" href="<%= localeUrl('/login?returnTo='+encodeURIComponent(recipe.href)) %>"><%= t('public:saveRecipe') %></a><% }else{ %><a class="button secondary" href="<%= localeUrl('/settings') %>"><%= t('public:workspaceRequired') %></a><% } %><% if(user){ %><form method="post" action="<%= localeUrl('/community/'+recipe.id+'/favorite') %>"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="button secondary" aria-pressed="<%= recipe.favorite %>"><%= recipe.favorite?t('common:sc3eacd2b6c18'):t('common:s10c559a1c494') %></button></form><% } %></div></header>
<% if(recipe.images.length){ %><div class="detail-cover"><img src="<%= localeUrl(recipe.images[0].url) %>" alt="<%= recipe.title %>" width="1600" height="1000" fetchpriority="high"></div><% }else{ %><div class="detail-cover food-placeholder"><span aria-hidden="true">♧</span><small><%= t('public:photoPlaceholder') %></small></div><% } %>
<div class="recipe-meta"><div><small><%= t('public:prepTime') %></small><strong><%= recipe.prepMinutes===null?t('public:timeUnavailable'):recipe.prepMinutes+' min' %></strong></div><div><small><%= t('public:cookTime') %></small><strong><%= recipe.cookMinutes===null?t('public:timeUnavailable'):recipe.cookMinutes+' min' %></strong></div><div><small><%= t('public:totalTime') %></small><strong><%= recipe.prepMinutes===null||recipe.cookMinutes===null?t('public:timeUnavailable'):recipe.prepMinutes+recipe.cookMinutes+' min' %></strong></div></div>
<div class="detail-columns"><section class="panel"><h2><%= t('public:ingredients') %></h2><% if(recipe.servings!==null){ %><label class="servings-control"><%= t('public:servings') %><input id="servings" type="number" min="1" max="100" value="<%= recipe.servings %>" data-base="<%= recipe.servings %>"></label><% } %><p id="servings-error" class="danger" role="status"></p><ul class="ingredient-list"><% recipe.ingredients.forEach(ingredient=>{ %><li><strong data-quantity="<%= ingredient.quantity??'' %>"><%= String(ingredient.quantity??'').replace('.',language==='en'?'.':',') %></strong> <%= unitLabel(ingredient.unit) %> <%= ingredient.name %><% if(ingredient.note){ %><small class="muted"><%= ingredient.note %></small><% } %></li><% }); %></ul></section><section class="panel instructions"><h2><%= t('public:instructions') %></h2><ol class="step-list"><% recipe.steps.forEach((step,index)=>{ %><li><span class="step-number"><%= index+1 %></span><p class="preserve"><%= step %></p></li><% }); %></ol></section></div>
<% if(recipe.images.length>1){ %><section class="gallery"><% recipe.images.slice(1).forEach(image=>{ %><a href="<%= localeUrl(image.url) %>"><img src="<%= localeUrl(image.thumbnail) %>" alt="<%= recipe.title %>" width="600" height="450" loading="lazy"></a><% }); %></section><% } %>
<% if(recipe.sourceDescription||recipe.sourceUrl){ %><section class="recipe-source"><h2><%= t('public:source') %></h2><p class="preserve"><%= recipe.sourceDescription %></p><% if(recipe.sourceUrl){ %><a class="text-link break-word" href="<%= recipe.sourceUrl %>" target="_blank" rel="noopener noreferrer"><%= t('public:openSource') %> ↗</a><% } %></section><% } %>
<% if(canManage){ %><p><a class="text-link" href="<%= localeUrl('/community/'+recipe.id+'?reviewLanguage='+recipe.language) %>"><%= t('public:managePublication') %></a></p><% } %>
</article><%- include('../layouts/footer') %>
