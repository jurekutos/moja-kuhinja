<%- include('../layouts/header') %>
<a class="back-link" href="/recipes/<%= recipe.id %>">← <%= recipe.title %></a>
<h1><%= t('common:translations') %> · <%= localeNames[translationLanguage] %></h1><p class="muted"><%= t('common:translationHelp') %></p>
<form class="stack" data-translation-form method="post" action="/recipes/<%= recipe.id %>/translations/<%= translationLanguage %>">
<input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="revision" value="<%= recipe.contentRevision %>"><input type="hidden" name="ingredientsJson" value="[]"><input type="hidden" name="stepsJson" value="[]">
<section class="panel stack"><label><%= t("recipes:s9bbf5bb58882") %><input name="title" maxlength="160" required value="<%= version.title %>"></label><label><%= t("recipes:sd277e08fa5a5") %><textarea name="description" maxlength="3000"><%= version.description %></textarea></label><p><%= recipe.servings %> <%= t("recipes:sc7fe034eb5f6") %> <%= recipe.prepMinutes + recipe.cookMinutes %> <%= t("recipes:s1f6fa6f69d18") %></p>
<h2><%= t("recipes:s49527351414c") %></h2><% recipe.ingredients.forEach(i=>{const text=ingredientTexts.find(v=>v.ingredientId===i.id); %><div data-translated-ingredient="<%= i.id %>" class="translation-grid"><p><%= i.quantity %> <%= unitLabel(i.unit) %> <%= i.name %> <%= i.note %></p><label><%= t("recipes:s86c6c9e6de93") %><input data-translation-name maxlength="150" value="<%= text?.name || '' %>"></label><label><%= t("recipes:s13edd8ae97e2") %><input data-translation-note maxlength="250" value="<%= text?.note || '' %>"></label></div><% }); %>
<h2><%= t("recipes:sb95c5bf44b2c") %></h2><% recipe.stepRows.forEach((step,index)=>{const text=stepTexts.find(v=>v.stepId===step.id); %><label><%= index+1 %>. <%= step.body %><textarea data-translated-step="<%= step.id %>" maxlength="3000"><%= text?.body || '' %></textarea></label><% }); %>
<label class="checkbox-label"><input name="reviewed" type="checkbox" value="1" <%= version.reviewed?'checked':'' %>><%= t('common:reviewTranslation') %></label><button class="button"><%= t('common:save') %></button></section></form>
<%- include('../layouts/footer') %>
