<%- include('../layouts/header') %><% if (typeof readCounts !== 'undefined' && readCounts) { %><%- include('../components/read-counts', { readCounts }) %><% } %><a class="back-link" href="<%= cooking ? '/recipes/' + recipe.id : '/recipes' %>">← <%= cooking ? 'Nazaj na recept' : 'Vsi recepti' %></a><article class="<%= cooking ? 'cooking-view' : 'recipe-detail' %>"><%- include('../components/recipe-header') %>
<% if (!cooking) { %><div class="detail-cover"><% if (recipe.images.length) { %><img src="/images/<%= recipe.images[0].id %>" alt="<%= recipe.title %>" width="1600" height="1000" fetchpriority="high"><% } else { %><div class="food-placeholder"><span aria-hidden="true">♧</span><small>Nekaj dobrega nastaja.</small></div><% } %></div><% } %>
<div class="recipe-meta"><div><small>PRIPRAVA</small><strong><%= recipe.prepMinutes %> min</strong></div><div><small>KUHANJE</small><strong><%= recipe.cookMinutes %> min</strong></div><div><small>SKUPAJ</small><strong><%= recipe.prepMinutes + recipe.cookMinutes %> min</strong></div></div><div class="detail-columns"><section class="panel ingredients-panel"><h2>Sestavine</h2><label class="servings-control">Porcije <input id="servings" type="number" value="<%= recipe.servings %>" min="1" max="100" data-base="<%= recipe.servings %>"></label><p class="small muted">Osnovni recept: <%= recipe.servings %> porcij. Količine se preračunajo samo za ogled.</p><p id="servings-error" role="status" class="danger"></p><ul class="ingredient-list"><% recipe.ingredients.forEach(i => { %><li><label><input type="checkbox"><span><strong data-quantity="<%= i.quantity ?? '' %>"><%= scaleQuantity(i.quantity, recipe.servings, recipe.servings) %></strong> <%= i.unit %> <%= i.name %><% if (i.note) { %><small><%= i.note %></small><% } %></span></label></li><% }); %></ul><% if (!recipe.ingredients.length) { %><p class="muted">Sestavine še niso dodane.</p><% } %></section><section class="panel instructions"><h2>Priprava</h2><% if (cooking) { %><p class="muted">Označite opravljene korake. Napredek velja samo na tej strani.</p><div class="cooking-tools"><button class="button secondary" id="reset-steps" type="button">Ponastavi korake</button><span id="step-progress" role="status">0 / <%= recipe.steps.length %></span></div><% } %><ol class="step-list"><% recipe.steps.forEach((step, index) => { %><li><% if (cooking) { %><label><input type="checkbox" class="step-checkbox" aria-label="Korak <%= index+1 %> opravljen"><span class="step-number"><%= index+1 %></span><span class="preserve"><%= step %></span></label><% } else { %><span class="step-number"><%= index+1 %></span><p class="preserve"><%= step %></p><% } %></li><% }); %></ol><% if (!recipe.steps.length) { %><p class="muted">Koraki še niso dodani.</p><% } %></section></div>
<% if (!cooking) { %><%- include('../components/notes') %><%- include('../components/share-recipe') %><% if (recipe.images.length > 1) { %><section class="gallery"><% recipe.images.slice(1).forEach(image => { %><a href="/images/<%= image.id %>"><img src="/images/<%= image.id %>?size=small" alt="Dodatna fotografija recepta" width="600" height="450" loading="lazy"></a><% }); %></section><% } %><%- include('../components/comments') %><section class="recipe-source"><h3>O receptu</h3><p>Vir: <%= ({ manual: 'Ročni vnos', url: 'Spletni naslov', photo: 'Fotografija', cookbook: 'Kuharska knjiga' })[recipe.sourceType] %></p><% if (recipe.sourceDescription) { %><p><%= recipe.sourceDescription %></p><% } %><% if (recipe.sourceUrl) { %><a class="text-link break-word" href="<%= recipe.sourceUrl %>" target="_blank" rel="noopener noreferrer">Odpri izvirni vir ↗</a><% } %></section><% } %></article><%- include('../layouts/footer') %>
