<%- include('../layouts/header') %><% if (typeof readCounts !== 'undefined' && readCounts) { %><%- include('../components/read-counts', { readCounts }) %><% } %><a class="back-link" href="<%= localeUrl((cooking ? '/recipes/' + recipe.id + '?lang=' + recipe.language : '/recipes')) %>">← <%= cooking ? t("recipes:sf8af6faa71ce") : t("recipes:s822bec4c2acb") %></a><article class="<%= cooking ? 'cooking-view' : 'recipe-detail' %>"><%- include('../components/recipe-header') %><%- include('../components/recipe-languages') %>
<% if (!cooking) { %><div class="detail-cover"><% if (recipe.images.length) { %><img src="<%= localeUrl("/images/" + (recipe.images[0].id)) %>" alt="<%= recipe.title %>" width="1600" height="1000" fetchpriority="high"><% } else { %><div class="food-placeholder"><span aria-hidden="true">♧</span><small><%= t("recipes:s140e5801aa07") %></small></div><% } %></div><% } %>
<div class="recipe-meta"><div><small><%= t("recipes:sd9a76dde0984") %></small><strong><%= recipe.prepMinutes %> <%= t("recipes:s1f6fa6f69d18") %></strong></div><div><small><%= t("recipes:sa4a6f6c256c9") %></small><strong><%= recipe.cookMinutes %> <%= t("recipes:s1f6fa6f69d18") %></strong></div><div><small><%= t("recipes:s69781d4ce55e") %></small><strong><%= recipe.prepMinutes + recipe.cookMinutes %> <%= t("recipes:s1f6fa6f69d18") %></strong></div></div><div class="detail-columns"><section class="panel ingredients-panel"><h2><%= t("recipes:s49527351414c") %></h2><label class="servings-control"><%= t("recipes:sd97145bb4a5d") %> <input id="servings" type="number" value="<%= recipe.servings %>" min="1" max="100" data-base="<%= recipe.servings %>"></label><p class="small muted"><%= t("recipes:sd31562a5d5a1") %> <%= recipe.servings %> <%= t("recipes:s21e4256db3a8") %></p><p id="servings-error" role="status" class="danger"></p><ul class="ingredient-list"><% recipe.ingredients.forEach(i => { %><li><label><input type="checkbox"><span><strong data-quantity="<%= i.quantity ?? '' %>"><%= scaleQuantity(i.quantity, recipe.servings, recipe.servings) %></strong> <%= unitLabel(i.unit) %> <%= i.name %><% if (i.note) { %><small><%= i.note %></small><% } %></span></label></li><% }); %></ul><% if (!recipe.ingredients.length) { %><p class="muted"><%= t("recipes:s9b02378b7e5a") %></p><% } %></section><section class="panel instructions"><h2><%= t("recipes:s4dd38350a781") %></h2><% if (cooking) { %><p class="muted"><%= t("recipes:sf20d33e24f3a") %></p><div class="cooking-tools"><button class="button secondary" id="reset-steps" type="button"><%= t("recipes:s327926db9190") %></button><span id="step-progress" role="status">0 / <%= recipe.steps.length %></span></div><% } %><ol class="step-list"><% recipe.steps.forEach((step, index) => { %><li><% if (cooking) { %><label><input type="checkbox" class="step-checkbox" aria-label="<%= t("recipes:s4f4ee2fd1e5f") %> <%= index+1 %> <%= t("recipes:s1b5a955469df") %>"><span class="step-number"><%= index+1 %></span><span class="preserve"><%= step %></span></label><% } else { %><span class="step-number"><%= index+1 %></span><p class="preserve"><%= step %></p><% } %></li><% }); %></ol><% if (!recipe.steps.length) { %><p class="muted"><%= t("recipes:sac8af4639e6e") %></p><% } %></section></div>
<% if (!cooking) { %><%- include('../components/notes') %><% if (recipe.images.length > 1) { %><section class="gallery"><% recipe.images.slice(1).forEach(image => { %><a href="<%= localeUrl("/images/" + (image.id)) %>"><img src="<%= localeUrl("/images/" + (image.id) + "?size=small") %>" alt="<%= t("recipes:sd30a73122890") %>" width="600" height="450" loading="lazy"></a><% }); %></section><% } %><%- include('../components/comments') %><section class="recipe-source"><h3><%= t("recipes:sd0354b026009") %></h3><p><%= t("recipes:sc2216568f7ca") %> <%= ({ manual: t("recipes:sa8137d394864"), url: t("recipes:s7c023288f690"), photo: t("recipes:s0b1d1942fdb1"), cookbook: t("recipes:s129deebc668b") })[recipe.sourceType] %></p><% if (recipe.sourceDescription) { %><p><%= recipe.sourceDescription %></p><% } %><% if (recipe.sourceUrl) { %><a class="text-link break-word" href="<%= localeUrl((recipe.sourceUrl)) %>" target="_blank" rel="noopener noreferrer"><%= t("recipes:s369bdc28e1b0") %></a><% } %></section><% } %></article><%- include('../layouts/footer') %>
