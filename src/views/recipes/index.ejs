<%- include('../layouts/header') %><a class="back-link" href="/recipes/statistics"><%= t("recipes:s186fb76bb39a") %></a><header class="page-header"><div><p class="eyebrow"><%= t("recipes:s6accf6a37c77") %></p><h1><%= ({workspace:t("recipes:sa55ecfbe2bf7"),all:t("recipes:s822bec4c2acb"),public:t("recipes:s2ce0bb9dbc65")})[view] %></h1><p class="muted"><%= t("recipes:s82521e0e23be") %></p></div><% if (user.role !== 'viewer') { %><a href="/recipes/new" class="button"><%= t("recipes:s2712f462a315") %></a><% } %></header><%- include('../components/author-filter') %><nav class="collection-tabs" aria-label="<%= t("recipes:s886909bc4ce5") %>"><% for (const [value,label] of [['workspace',t("recipes:sd62e71a971f6")],['all',t("recipes:s822bec4c2acb")],['public',t("recipes:see009662168f")]]) { %><a href="<%= viewLink(value) %>" <%- view === value ? 'aria-current="page"' : '' %>><%= label %></a><% } %></nav><form action="/recipes" method="get" class="filters"><input type="hidden" name="view" value="<%= view %>"><% if (query.author) { %><input type="hidden" name="author" value="<%= query.author %>"><% } %><label><%= t("recipes:sa38f76822498") %><input type="search" name="q" value="<%= typeof query.q === 'string' ? query.q : '' %>" placeholder="<%= t("recipes:s2a203edaa7b8") %>" maxlength="160"></label><label><%= t("recipes:s119dd8d6a84e") %><input type="search" name="ingredient" value="<%= typeof query.ingredient === 'string' ? query.ingredient : '' %>" placeholder="<%= t("recipes:s6e4ea9642719") %>" maxlength="150"></label><label><%= t("recipes:s5ff4db960bc3") %><select name="category"><option value=""><%= t("recipes:sb421e4429364") %></option><% categories.forEach(c => { %><option value="<%= c.id %>" <%= query.category === String(c.id) ? 'selected' : '' %>><%= c.name %></option><% }); %></select></label><label><%= t("recipes:scdf0456ebf9b") %><select name="sort"><option value="newest"><%= t("recipes:s82c5f2c4da8a") %></option><option value="alpha" <%= query.sort === 'alpha' ? 'selected' : '' %>><%= t("recipes:sa195e56a90f7") %></option></select></label><label class="checkbox-label"><input type="checkbox" name="favorite" value="1" <%= query.favorite === '1' ? 'checked' : '' %>> <%= t("recipes:sed901324b206") %></label><button class="button"><%= t("recipes:sc808f4beba2d") %></button><a class="text-link" href="/recipes?view=<%= view %>"><%= t("recipes:s4b9c8d149601") %></a></form><p class="muted result-count"><%= count %> <%= t("recipes:s7b9e77380ca6") %></p><% if (recipes.length) { %><div class="recipe-grid"><% recipes.forEach(recipe => { %><%- include('../components/card', { recipe }) %><% }); %></div><% if (pages > 1) { %><nav class="pagination" aria-label="<%= t("recipes:sbc09f873a5e8") %>"><% if (page > 1) { %><a class="button secondary" href="<%= pageLink(page-1) %>"><%= t("recipes:s579258446055") %></a><% } %><span><%= page %> / <%= pages %></span><% if (page < pages) { %><a class="button secondary" href="<%= pageLink(page+1) %>"><%= t("recipes:s051dd8e9285b") %></a><% } %></nav><% } %><% } else { %><div class="empty-state"><span aria-hidden="true">⌕</span><h2><%= t("recipes:s4bc5cb2c5dc8") %></h2><p><%= t("recipes:s65e60cc778a5") %></p><% if (user.role !== 'viewer') { %><a href="/recipes/new" class="button"><%= t("recipes:s92691648443e") %></a><% } %></div><% } %><%- include('../layouts/footer') %>
