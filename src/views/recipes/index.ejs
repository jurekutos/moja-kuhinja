<%- include('../layouts/header') %><a class="back-link" href="/recipes/statistics">Branost receptov →</a><header class="page-header"><div><p class="eyebrow">SHRANJENO ZA NASLEDNJIČ</p><h1><%= ({workspace:'Recepti mojega prostora',all:'Vsi recepti',public:'Javni recepti'})[view] %></h1><p class="muted">Preizkušeni okusi in zamisli za nove najljubše jedi.</p></div><% if (user.role !== 'viewer') { %><a href="/recipes/new" class="button">+ Nov recept</a><% } %></header><%- include('../components/author-filter') %><nav class="collection-tabs" aria-label="Zbirke receptov"><% for (const [value,label] of [['workspace','Moj prostor'],['all','Vsi recepti'],['public','Samo javni']]) { %><a href="<%= viewLink(value) %>" <%- view === value ? 'aria-current="page"' : '' %>><%= label %></a><% } %></nav><form action="/recipes" method="get" class="filters"><input type="hidden" name="view" value="<%= view %>"><% if (query.author) { %><input type="hidden" name="author" value="<%= query.author %>"><% } %><label>Ime recepta<input type="search" name="q" value="<%= typeof query.q === 'string' ? query.q : '' %>" placeholder="Poišči nekaj dobrega …" maxlength="160"></label><label>Sestavina<input type="search" name="ingredient" value="<%= typeof query.ingredient === 'string' ? query.ingredient : '' %>" placeholder="npr. piščanec" maxlength="150"></label><label>Kategorija<select name="category"><option value="">Vse kategorije</option><% categories.forEach(c => { %><option value="<%= c.id %>" <%= query.category === String(c.id) ? 'selected' : '' %>><%= c.name %></option><% }); %></select></label><label>Razvrsti<select name="sort"><option value="newest">Najnovejši</option><option value="alpha" <%= query.sort === 'alpha' ? 'selected' : '' %>>Po abecedi</option></select></label><label class="checkbox-label"><input type="checkbox" name="favorite" value="1" <%= query.favorite === '1' ? 'checked' : '' %>> Moji priljubljeni</label><button class="button">Poišči</button><a class="text-link" href="/recipes?view=<%= view %>">Počisti</a></form><p class="muted result-count"><%= count %> receptov</p><% if (recipes.length) { %><div class="recipe-grid"><% recipes.forEach(recipe => { %><%- include('../components/card', { recipe }) %><% }); %></div><% if (pages > 1) { %><nav class="pagination" aria-label="Strani z recepti"><% if (page > 1) { %><a class="button secondary" href="<%= pageLink(page-1) %>">← Prejšnja</a><% } %><span><%= page %> / <%= pages %></span><% if (page < pages) { %><a class="button secondary" href="<%= pageLink(page+1) %>">Naslednja →</a><% } %></nav><% } %><% } else { %><div class="empty-state"><span aria-hidden="true">⌕</span><h2>Tu je prostor za nove okuse.</h2><p>Ni receptov za izbrane pogoje. Spremenite iskanje ali dodajte nov recept.</p><% if (user.role !== 'viewer') { %><a href="/recipes/new" class="button">Dodaj recept</a><% } %></div><% } %><%- include('../layouts/footer') %>
