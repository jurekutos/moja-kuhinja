<%- include('../layouts/header') %>
<a class="back-link" href="<%= localeUrl("/recipes") %>"><%= t("recipes:s2baf6d31f69f") %></a>
<header class="page-header"><div><p class="eyebrow"><%= t("recipes:se3aa6835cbdc") %></p><h1><%= t("recipes:sd5f49afc8918") %></h1><p class="muted"><%= t("recipes:s3dd2c13b3f09") %></p></div></header>
<form class="filters" method="get" action="<%= localeUrl("/recipes/statistics") %>"><label><%= t("recipes:s4fcf34b5ca91") %><select name="view"><% for (const [value,label] of [['all',t("recipes:s822bec4c2acb")],['workspace',t("recipes:sd62e71a971f6")],['public',t("recipes:see009662168f")]]) { %><option value="<%= value %>" <%= view === value ? 'selected' : '' %>><%= label %></option><% } %></select></label><label><%= t("recipes:s7531eeb15afb") %><select name="period"><option value="total" <%= period === 'total' ? 'selected' : '' %>><%= t("recipes:s57873c25ea3e") %></option><option value="month" <%= period === 'month' ? 'selected' : '' %>><%= t("recipes:s9a5fea9a2239") %></option></select></label><button class="button"><%= t("recipes:s4103239477eb") %></button></form>
<section class="panel"><h2><%= t("recipes:s37384a4905e2") %></h2><%- include('../components/read-counts', { readCounts: totals }) %><p class="muted small"><%= t("recipes:s38e509541089") %></p></section>
<h2><%= t("recipes:sf824998721d9") %></h2>
<% if (!recipes.length) { %><div class="empty-state"><p><%= t("recipes:sa6485b6b7f53") %></p></div><% } %>
<% recipes.forEach((recipe,index) => { %><article class="panel member-row"><div><p class="eyebrow"><%= index + 1 %> · <%= recipe.kind === 'public' ? t("recipes:s8960603fb182") : t("recipes:sd62e71a971f6") %></p><h3><a href="<%= localeUrl("/" + (recipe.kind === 'public' ? 'community' : 'recipes') + "/" + (recipe.id)) %>"><%= recipe.title %></a></h3><%- include('../components/read-counts', { readCounts: recipe }) %></div></article><% }); %>
<% if (recipes.length === 50) { %><p class="muted"><%= t("recipes:s53a8dee80784") %></p><% } %>
<%- include('../layouts/footer') %>
