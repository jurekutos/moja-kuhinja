<%- include('../layouts/header') %><a class="back-link" href="<%= recipe.id ? '/recipes/' + recipe.id : '/recipes' %>">← Nazaj na recepte</a><header class="page-header"><div><p class="eyebrow">DODAJ ŠČEPEC SVOJEGA</p><h1><%= recipe.id ? 'Uredi recept' : 'Nov recept' %></h1><p class="muted">Dober recept si zasluži svoje mesto.</p></div><span class="tag"><%= recipe.status === 'draft' ? 'Osnutek' : 'Objavljeno' %></span></header>
<% if (errors.length) { %><div class="errors" role="alert" tabindex="-1" id="validation-errors"><h2>Preverite vnos</h2><ul><% errors.forEach(e => { %><li><%= e %></li><% }); %></ul></div><% } %>
<% if (preview) { %><section class="panel preview"><p class="eyebrow">PREDOGLED · ŠE NI SHRANJENO</p><h2><%= recipe.title %></h2><p class="preserve"><%= recipe.description %></p><p><%= recipe.prepMinutes + recipe.cookMinutes %> min · <%= recipe.servings %> porcij</p><h3>Sestavine</h3><ul><% recipe.ingredients.forEach(i => { %><li><%= i.quantity?.replace('.', ',') || '' %> <%= i.unit %> <%= i.name %><%= i.note ? ' — ' + i.note : '' %></li><% }); %></ul><h3>Priprava</h3><ol><% recipe.steps.forEach(s => { %><li class="preserve"><%= s %></li><% }); %></ol><p class="small muted">Spodaj preverite podatke in izberite »Shrani recept«.</p></section><% } %>
<form action="<%= recipe.id ? '/recipes/' + recipe.id : '/recipes' %>" method="post" id="recipe-form" class="stack"><input type="hidden" name="_csrf" value="<%= csrf %>"><section class="panel stack"><h2>Osnovni podatki</h2><label>Naslov recepta <span class="required">*</span><input name="title" value="<%= recipe.title %>" required maxlength="160" placeholder="Kako se imenuje vajina najljubša jed?"></label><label>Kratek opis<textarea name="description" rows="3" maxlength="3000" placeholder="Nekaj besed o tem, zakaj je ta jed posebna."><%= recipe.description %></textarea></label><div class="form-grid"><label>Priprava (min)<input type="number" name="prepMinutes" min="0" max="10080" step="1" required value="<%= recipe.prepMinutes %>"></label><label>Kuhanje (min)<input type="number" name="cookMinutes" min="0" max="10080" step="1" required value="<%= recipe.cookMinutes %>"></label><label>Število porcij<input type="number" name="servings" min="1" max="100" required value="<%= recipe.servings %>"></label></div><label>Kategorije <span class="muted">(ločene z vejicami)</span><input name="categories" value="<%= recipe.categories.join(', ') %>" maxlength="510" placeholder="Kosilo, Vegetarijansko, Hitro"><small>Največ 10 kategorij, vsaka do 50 znakov.</small></label></section>
<section class="panel stack" id="ingredient-section"><div class="section-heading"><div><h2>Sestavine</h2><p class="muted small">Količino pustite prazno pri sestavinah po okusu.</p></div></div><input type="hidden" name="ingredientsJson" id="ingredients-json" value="<%= JSON.stringify(recipe.ingredients.map(i => ({ name: i.name, quantity: i.quantity ?? '', unit: i.unit, note: i.note }))) %>"><div id="ingredient-rows"></div><datalist id="units"><% ['g','kg','ml','l','kos','žlica','žlička','po okusu'].forEach(u => { %><option value="<%= u %>"><% }); %></datalist><button type="button" id="add-ingredient" class="button secondary">+ Dodaj sestavino</button></section>
<section class="panel stack"><h2>Koraki priprave</h2><p class="muted small">Razdelite pripravo na preproste korake. Vrstni red spreminjate s puščicami.</p><input type="hidden" name="stepsJson" id="steps-json" value="<%= JSON.stringify(recipe.steps) %>"><div id="step-rows"></div><button type="button" class="button secondary" id="add-step">+ Dodaj korak</button></section>
<section class="panel stack"><h2>Opombe in vir</h2><label>Moje opombe<textarea name="notes" rows="3" maxlength="10000" placeholder="Namigi, zamenjave sestavin, vajine drobne skrivnosti …"><%= recipe.notes %></textarea><small>Opombe so zasebne in vidne samo vam.</small></label><div class="form-grid two"><label>Vrsta vira<select name="sourceType"><% for (const [value,label] of [['manual','Ročni vnos'],['url','Spletni naslov'],['photo','Fotografija'],['cookbook','Kuharska knjiga']]) { %><option value="<%= value %>" <%= recipe.sourceType === value ? 'selected' : '' %>><%= label %></option><% } %></select></label><label>Spletni naslov vira<input type="url" name="sourceUrl" value="<%= recipe.sourceUrl %>" maxlength="2000" placeholder="https://…"></label></div><label>Opis vira ali sklic na knjigo<input name="sourceDescription" value="<%= recipe.sourceDescription %>" maxlength="1000" placeholder="Naslov knjige, avtor in stran"></label><p class="small muted">Vir je samo podatek. Samodejni uvoz v tej fazi ni na voljo.</p></section><section class="panel save-panel"><label>Stanje<select name="status"><option value="draft" <%= recipe.status === 'draft' ? 'selected' : '' %>>Osnutek</option><option value="published" <%= recipe.status === 'published' ? 'selected' : '' %>>Objavljeno</option></select></label><button class="button secondary" name="intent" value="preview">Predogled</button><button class="button" name="intent" value="save">Shrani recept</button></section><noscript><p class="errors">Za urejanje sestavin in korakov omogočite JavaScript.</p></noscript></form>
<section class="panel stack" id="photos"><h2>Fotografije</h2><% if (recipe.id) { %><p class="muted">Prva slika je naslovna. Največ 10 slik na recept.</p><div class="image-manager"><% recipe.images.forEach((image, i) => { %><div><img src="/images/<%= image.id %>?size=small" alt="Fotografija recepta <%= i+1 %>" loading="lazy" width="600" height="450"><div class="actions"><% if (i === 0) { %><span class="tag">Naslovna</span><% } else { %><form action="/images/<%= image.id %>/cover" method="post"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="text-link">Za naslovno</button></form><% } %><form action="/images/<%= image.id %>/delete" method="post" data-confirm="Odstranim to fotografijo?"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="text-link danger">Odstrani</button></form></div></div><% }); %></div><form action="/recipes/<%= recipe.id %>/images" method="post" enctype="multipart/form-data" class="stack"><input type="hidden" name="_csrf" value="<%= csrf %>"><label>Dodaj fotografije<input type="file" name="images" accept="image/jpeg,image/png,image/webp" multiple required></label><small>JPEG, PNG ali WebP, do 8 MB na sliko in največ 5 slik hkrati. Za zamenjavo dodajte novo sliko, jo nastavite za naslovno in odstranite prejšnjo.</small><button class="button secondary">Naloži slike</button></form><% } else { %><p class="muted">Najprej shranite recept. Nato boste lahko dodali naslovno in dodatne fotografije.</p><% } %></section><%- include('../layouts/footer') %>
