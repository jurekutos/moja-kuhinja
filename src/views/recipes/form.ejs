<%- include('../layouts/header') %><a class="back-link" href="<%= localeUrl((recipe.id ? '/recipes/' + recipe.id : '/recipes')) %>"><%= t("recipes:s45ff1ec36e24") %></a><header class="page-header"><div><p class="eyebrow"><%= t("recipes:s4e3f938e301d") %></p><h1><%= recipe.id ? t("recipes:s49c1c23a4a70") : t("recipes:sc0961b8473ff") %></h1><p class="muted"><%= t("recipes:sa5d196c42e5c") %></p></div><span class="tag"><%= recipe.status === 'draft' ? t("recipes:sa4cf485f8f37") : t("recipes:sd32e7752af04") %></span></header>
<% if (errors.length) { %><div class="errors" role="alert" tabindex="-1" id="validation-errors"><h2><%= t("recipes:s232ecbaeb40a") %></h2><ul><% errors.forEach(e => { %><li><%= e %></li><% }); %></ul></div><% } %>
<% if (preview) { %><section class="panel preview"><p class="eyebrow"><%= t("recipes:s3489552ee46d") %></p><h2><%= recipe.title %></h2><p class="preserve"><%= recipe.description %></p><p><%= recipe.prepMinutes + recipe.cookMinutes %> <%= t("recipes:seb8368e0da20") %> <%= recipe.servings %> <%= t("recipes:sb65ac01bc4c7") %></p><h3><%= t("recipes:s49527351414c") %></h3><ul><% recipe.ingredients.forEach(i => { %><li><%= scaleQuantity(i.quantity, recipe.servings, recipe.servings) %> <%= unitLabel(i.unit) %> <%= i.name %><%= i.note ? ' — ' + i.note : '' %></li><% }); %></ul><h3><%= t("recipes:s4dd38350a781") %></h3><ol><% recipe.steps.forEach(s => { %><li class="preserve"><%= s %></li><% }); %></ol><p class="small muted"><%= t("recipes:sa3766603fa0a") %></p></section><% } %>
<form action="<%= localeUrl((recipe.id ? '/recipes/' + recipe.id : '/recipes')) %>" method="post" id="recipe-form" class="stack"><input type="hidden" name="_csrf" value="<%= csrf %>"><section class="panel stack"><h2><%= t("recipes:sf8fafc87f4f2") %></h2><label><%= t('common:originalLanguage') %><select name="originalLanguage" <%= recipe.id?'disabled':'' %>><% languages.forEach(code=>{ %><option value="<%= code %>" <%= (recipe.originalLanguage || language)===code?'selected':'' %>><%= localeNames[code] %></option><% }); %></select></label><label><%= t("recipes:s1cc1cab49a9d") %> <span class="required">*</span><input name="title" value="<%= recipe.title %>" required maxlength="160" placeholder="<%= t("recipes:s5daea32c51f5") %>"></label><label><%= t("recipes:sd277e08fa5a5") %><textarea name="description" rows="3" maxlength="3000" placeholder="<%= t("recipes:seb403557dff9") %>"><%= recipe.description %></textarea></label><div class="form-grid"><label><%= t("recipes:safbb65506e9f") %><input type="number" name="prepMinutes" min="0" max="10080" step="1" required value="<%= recipe.prepMinutes %>"></label><label><%= t("recipes:s5efe15b32929") %><input type="number" name="cookMinutes" min="0" max="10080" step="1" required value="<%= recipe.cookMinutes %>"></label><label><%= t("recipes:sd59aa862e14d") %><input type="number" name="servings" min="1" max="100" required value="<%= recipe.servings %>"></label></div><label><%= t("recipes:s62d5c6fd6eb0") %> <span class="muted"><%= t("recipes:s6fdf8a802197") %></span><input name="categories" value="<%= recipe.categories.join(', ') %>" maxlength="510" placeholder="<%= t("recipes:s8c30c9717310") %>"><small><%= t("recipes:s8c00c13f5379") %></small></label></section>
<%- include('../components/recipe-structure',{recipe}) %>
<section class="panel stack"><h2><%= t("recipes:sbef7dd9c3e19") %></h2><label><%= t("recipes:s0870ba68fb39") %><textarea name="notes" rows="3" maxlength="10000" placeholder="<%= t("recipes:sa81d8d2fca46") %>"><%= recipe.notes %></textarea><small><%= t("recipes:s852a192d1f0b") %></small></label><div class="form-grid two"><label><%= t("recipes:s877c59038680") %><select name="sourceType"><% for (const [value,label] of [['manual',t("recipes:sa8137d394864")],['url',t("recipes:s7c023288f690")],['photo',t("recipes:s0b1d1942fdb1")],['cookbook',t("recipes:s129deebc668b")]]) { %><option value="<%= value %>" <%= recipe.sourceType === value ? 'selected' : '' %>><%= label %></option><% } %></select></label><label><%= t("recipes:s5633836097c6") %><input type="url" name="sourceUrl" value="<%= recipe.sourceUrl %>" maxlength="2000" placeholder="<%= t("recipes:sab04e20ed4f2") %>"></label></div><label><%= t("recipes:se890ca217afa") %><input name="sourceDescription" value="<%= recipe.sourceDescription %>" maxlength="1000" placeholder="<%= t("recipes:s659fd0a78162") %>"></label><p class="small muted"><%= t("recipes:s6a60b4d8ddcc") %></p></section><section class="panel save-panel"><label><%= t("recipes:s4e6c2c30de56") %><select name="status"><option value="draft" <%= recipe.status === 'draft' ? 'selected' : '' %>><%= t("recipes:sa4cf485f8f37") %></option><option value="published" <%= recipe.status === 'published' ? 'selected' : '' %>><%= t("recipes:sd32e7752af04") %></option></select></label><button class="button secondary" name="intent" value="preview"><%= t("recipes:sf659f24d25d6") %></button><button class="button" name="intent" value="save"><%= t("recipes:sc72ac99fc988") %></button></section><noscript><p class="errors"><%= t("recipes:s4cf69051e5da") %></p></noscript></form>
<section class="panel stack" id="photos"><h2><%= t("recipes:s42201c72b541") %></h2><% if (recipe.id) { %><p class="muted"><%= t("recipes:s5e65010136cd") %></p><div class="image-manager"><% recipe.images.forEach((image, i) => { %><div><img src="<%= localeUrl("/images/" + (image.id) + "?size=small") %>" alt="<%= t("recipes:s851dc4bbca4c") %> <%= i+1 %>" loading="lazy" width="600" height="450"><div class="actions"><% if (i === 0) { %><span class="tag"><%= t("recipes:s505283d5e071") %></span><% } else { %><form action="<%= localeUrl("/images/" + (image.id) + "/cover") %>" method="post"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="text-link"><%= t("recipes:s0b21600ce305") %></button></form><% } %><form action="<%= localeUrl("/images/" + (image.id) + "/delete") %>" method="post" data-confirm="<%= t("recipes:s2d0e8ef9b1c8") %>"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="text-link danger"><%= t("recipes:s0f11f64797b0") %></button></form></div></div><% }); %></div><form action="<%= localeUrl("/recipes/" + (recipe.id) + "/images") %>" method="post" enctype="multipart/form-data" class="stack"><input type="hidden" name="_csrf" value="<%= csrf %>"><label><%= t("recipes:se78594f8b166") %><input type="file" name="images" accept="image/jpeg,image/png,image/webp" multiple required></label><small><%= t("recipes:s9baa81683bcb") %></small><button class="button secondary"><%= t("recipes:s5a383566789e") %></button></form><% } else { %><p class="muted"><%= t("recipes:s59ae4130d927") %></p><% } %></section><%- include('../layouts/footer') %>
