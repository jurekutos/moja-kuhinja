<%- include('../layouts/header') %><header class="page-header"><h1><%= title %></h1><a class="button" href="<%= localeUrl('/super-admin/public-recipes/new') %>"><%= t('library:new') %></a></header><%- include('../super-admin/nav') %>
<section class="panel stack"><h2><%= t('public:featured') %></h2><p><%= t('library:featuredHelp') %></p><form class="stack" method="post" action="<%= localeUrl('/super-admin/public-recipes/featured') %>"><input type="hidden" name="_csrf" value="<%= csrf %>"><% ['first','second','third'].forEach((name,index)=>{ %><label><%= index+1 %><select name="<%= name %>" required><option value=""><%= t('common:select') %></option><% rows.filter(row=>row.status==='approved').forEach(row=>{ %><option value="<%= row.id %>" <%= featured.some(f=>f.position===index+1&&f.publicationId===row.id)?'selected':'' %>><%= row.title %></option><% }); %></select></label><% }); %><button class="button"><%= t('library:saveOrder') %></button></form></section>
<section class="stack"><% if(!rows.length){ %><p class="panel"><%= t('public:emptyDescription') %></p><% } %><% rows.forEach(row=>{ %><article class="panel member-row"><div><h2><%= row.title %></h2><span class="tag"><%= t('library:'+row.status) %></span></div><a class="button secondary" href="<%= localeUrl('/super-admin/public-recipes/'+row.id+'/edit?contentLanguage='+row.language) %>"><%= t('library:edit') %></a></article><% }); %></section><%- include('../layouts/footer') %>
