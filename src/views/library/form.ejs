<%- include('../layouts/header') %><header class="page-header"><div><h1><%= title %></h1><p class="muted"><%= t('library:help') %></p></div><a class="text-link" href="<%= localeUrl(admin?'/super-admin/public-recipes':'/submissions') %>"><%= t('library:back') %></a></header>
<% if(errors.length){ %><div class="errors" role="alert" id="validation-errors" tabindex="-1"><% errors.forEach(error=>{ %><p class="preserve"><%= error %></p><% }); %></div><% } %>
<form id="recipe-form" class="stack" method="post" action="<%= localeUrl(admin?'/super-admin/public-recipes'+(row?'/'+row.publicationId:''):'/suggestions') %>"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="version" value="<%= version %>"><input type="hidden" name="contentLanguage" value="<%= recipe.originalLanguage %>">
<section class="panel stack"><label><%= t('common:originalLanguage') %><select name="originalLanguage"><% languages.filter(code=>!row||code===row.language).forEach(code=>{ %><option value="<%= code %>" <%= code===recipe.originalLanguage?'selected':'' %>><%= localeNames[code] %></option><% }); %></select></label><label><%= t('recipes:s1cc1cab49a9d') %><input name="title" value="<%= recipe.title %>" required maxlength="160"></label><label><%= t('recipes:sd277e08fa5a5') %><textarea name="description" rows="3" maxlength="3000"><%= recipe.description %></textarea></label><div class="form-grid"><% for(const [key,label] of [['prepMinutes','public:prepTime'],['cookMinutes','public:cookTime'],['servings','public:servings']]){ %><label><%= t(label) %><input name="<%= key %>" type="number" value="<%= recipe[key] %>" min="<%= key==='servings'?1:0 %>" max="<%= key==='servings'?100:10080 %>" required></label><% } %></div><fieldset><legend><%= t('recipes:s62d5c6fd6eb0') %></legend><div class="actions"><% categories.forEach(category=>{ %><label class="checkbox"><input type="checkbox" name="categoryIds" value="<%= category.id %>" <%= selected.includes(category.id)?'checked':'' %>><%= category.name %></label><% }); %></div></fieldset></section>
<%- include('../components/recipe-structure',{recipe}) %>
<section class="panel stack"><label><%= t('public:source') %><input name="sourceDescription" maxlength="1000" value="<%= recipe.sourceDescription %>"></label><label><%= t('recipes:s5633836097c6') %><input name="sourceUrl" type="url" maxlength="2000" value="<%= recipe.sourceUrl %>"></label><div class="actions"><% if(admin){ %><button class="button secondary" name="intent" value="draft"><%= t('library:saveDraft') %></button><button class="button" name="intent" value="publish"><%= t('library:publish') %></button><% }else{ %><button class="button" name="intent" value="suggest"><%= t('library:send') %></button><% } %></div></section><noscript><p class="errors"><%= t('recipes:s4cf69051e5da') %></p></noscript></form>
<% if(admin&&row){ %><section class="panel stack"><h2><%= t('library:moderation') %> &middot; <%= t('library:'+row.status) %></h2><form class="stack" method="post" action="<%= localeUrl('/super-admin/public-recipes/'+row.publicationId+'/moderate') %>" data-confirm="<%= t('library:confirm') %>"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="version" value="<%= version %>"><input type="hidden" name="contentLanguage" value="<%= row.language %>"><label><%= t('library:feedback') %><textarea name="feedback" maxlength="2000"><%= row.feedback %></textarea></label><div class="actions"><button class="button" name="decision" value="approved"><%= t('library:publish') %></button><button class="button secondary" name="decision" value="draft"><%= t('library:unpublish') %></button><button class="button secondary danger" name="decision" value="rejected"><%= t('library:reject') %></button></div></form></section>
<section class="panel stack"><h2><%= t('recipes:s42201c72b541') %></h2><div class="image-manager"><% (recipe.images||[]).forEach((image,index)=>{ %><div><img width="600" height="450" src="<%= localeUrl('/community/'+row.publicationId+'/images/'+index+'?size=small&reviewLanguage='+row.language) %>" alt="<%= recipe.title %>"><form method="post" action="<%= localeUrl('/super-admin/public-recipes/'+row.publicationId+'/images/'+index+'/delete') %>" data-confirm="<%= t('library:confirm') %>"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="version" value="<%= version %>"><input type="hidden" name="contentLanguage" value="<%= row.language %>"><button class="button secondary danger"><%= t('common:remove') %></button></form></div><% }); %></div><form class="stack" method="post" enctype="multipart/form-data" action="<%= localeUrl('/super-admin/public-recipes/'+row.publicationId+'/images') %>"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="version" value="<%= version %>"><input type="hidden" name="contentLanguage" value="<%= row.language %>"><label><%= t('recipes:se78594f8b166') %><input type="file" name="images" accept="image/jpeg,image/png,image/webp" multiple required></label><small><%= t('recipes:s9baa81683bcb') %></small><button class="button secondary"><%= t('recipes:s5a383566789e') %></button></form></section><% } %><%- include('../layouts/footer') %>
