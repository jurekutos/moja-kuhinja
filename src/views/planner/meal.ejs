<%- include('../layouts/header') %><a class="back-link" href="/planner?week=<%= week %>#day-<%= date %>"><%= t("planner:saef23a4c20d5") %></a><header class="page-header"><div><p class="eyebrow"><%= slot === 'lunch' ? t('common:lunchUpper') : t("planner:sc8a8fddaed6b") %> · <%= dateLabel(date,{weekday:'long',day:'numeric',month:'long',year:'numeric'}) %></p><h1><%= entry ? t("planner:s709440abd319") : t("planner:s25a5b1b19474") %></h1><p class="muted"><%= t("planner:sd24c34aeb323") %></p></div></header>
<% if (errors.length) { %><div class="errors" role="alert"><% errors.forEach(error => { %><p><%= error %></p><% }); %></div><% } %>
<% if (entry) { %><p class="notice"><%= t("planner:s006a09a8798e") %> <strong><%= entry.title %></strong> <%= t("planner:s2b3832000e19") %> <%= entry.servings %><%= entry.available ? '' : t("planner:s01c8af0f3178") %></p><% } %>
<section class="panel stack" id="selected-meal"><h2><%= t("planner:sdd9c9fea05eb") %></h2><% if (selected) { %><h3><%= selected.title %></h3><p class="small muted"><%= t("planner:sd31562a5d5a1") %> <%= selected.servings %> <%= t("planner:sc7fe034eb5f6") %> <%= selected.minutes %> <%= t("planner:s1f6fa6f69d18") %></p><form method="post" action="/planner/save" class="planner-save-form"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="date" value="<%= date %>"><input type="hidden" name="slot" value="<%= slot %>"><input type="hidden" name="recipe" value="<%= recipe %>"><input type="hidden" name="revision" value="<%= revision %>"><label><%= t("planner:sd59aa862e14d") %><input type="number" name="servings" min="1" max="100" step="1" value="<%= servings %>" required></label><button class="button"><%= t("planner:s795ef2aa2506") %></button></form><% } else { %><p class="muted"><%= t("planner:sd88e7950d77b") %></p><% } %></section>
<section><div class="section-heading"><div><p class="eyebrow"><%= t("planner:s8939c50ec1d8") %></p><h2><%= t("planner:sa5c6eb0a857b") %></h2></div></div><form method="get" action="/planner/meal" class="filters"><input type="hidden" name="date" value="<%= date %>"><input type="hidden" name="slot" value="<%= slot %>"><% if (recipe) { %><input type="hidden" name="recipe" value="<%= recipe %>"><% } %><label><%= t("planner:sa38f76822498") %><input type="search" name="q" maxlength="160" value="<%= typeof query.q === 'string' ? query.q : '' %>" placeholder="<%= t("planner:sde572d21ac99") %>"></label><label><%= t("planner:s4fcf34b5ca91") %><select name="view"><option value="all" <%= choices.view === 'all' ? 'selected' : '' %>><%= t("planner:s822bec4c2acb") %></option><option value="workspace" <%= choices.view === 'workspace' ? 'selected' : '' %>><%= t("planner:sd62e71a971f6") %></option><option value="public" <%= choices.view === 'public' ? 'selected' : '' %>><%= t("planner:see009662168f") %></option></select></label><label class="checkbox-label"><input type="checkbox" name="favorite" value="1" <%= query.favorite === '1' ? 'checked' : '' %>> <%= t("planner:sed901324b206") %></label><button class="button secondary"><%= t("planner:sc808f4beba2d") %></button></form><p class="result-count muted"><%= choices.count %> <%= t("planner:se689ec50f5e5") %></p>
<% if (choices.recipes.length) { %><div class="recipe-grid"><% choices.recipes.forEach(choice => { const key = `${choice.communityId ? 'public' : 'workspace'}:${choice.id}`; %><article class="recipe-card"><div class="card-image"><% if (choice.images.length) { %><img src="<%= choice.communityId ? '/community/' + choice.id + '/images/0' : '/images/' + choice.images[0].id %>?size=small" alt="<%= choice.title %>" loading="lazy" width="600" height="450"><% } else { %><div class="food-placeholder"><span aria-hidden="true">♧</span></div><% } %></div><div class="card-content stack"><span class="small muted"><%= choice.communityId ? t("planner:s8960603fb182") : t("planner:sd62e71a971f6") %></span><h3><%= choice.title %></h3><p class="small muted"><%= choice.prepMinutes + choice.cookMinutes %> <%= t("planner:s92446c527e19") %> <%= choice.servings %></p><a class="button <%= recipe === key ? '' : 'secondary' %>" href="<%= choiceLink(key) %>#selected-meal"><%= recipe === key ? t("planner:s55da46076bc9") : t("planner:s8d1c7b9da35a") %></a></div></article><% }); %></div><% if (choices.pages > 1) { %><nav class="pagination" aria-label="<%= t("planner:s8c39a6ab55be") %>"><% if (choices.page > 1) { %><a class="button secondary" href="<%= choicePage(choices.page-1) %>"><%= t("planner:s579258446055") %></a><% } %><span><%= choices.page %> / <%= choices.pages %></span><% if (choices.page < choices.pages) { %><a class="button secondary" href="<%= choicePage(choices.page+1) %>"><%= t("planner:s051dd8e9285b") %></a><% } %></nav><% } %><% } else { %><div class="empty-state"><span aria-hidden="true">♧</span><h3><%= t("planner:sdb682a9fb19a") %></h3><p><%= t("planner:sc2f0bc06454b") %></p><a class="button secondary" href="/recipes"><%= t("planner:se6ca5cbba4a1") %></a></div><% } %></section><%- include('../layouts/footer') %>
