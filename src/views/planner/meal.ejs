<%- include('../layouts/header') %><a class="back-link" href="/planner?week=<%= week %>#day-<%= date %>">← Nazaj na jedilnik</a><header class="page-header"><div><p class="eyebrow"><%= slot === 'lunch' ? 'KOSILO' : 'VEČERJA' %> · <%= dateLabel(date,{weekday:'long',day:'numeric',month:'long',year:'numeric'}) %></p><h1><%= entry ? 'Uredi obrok' : 'Dodaj obrok' %></h1><p class="muted">Izberite recept in število porcij za skupni jedilnik.</p></div></header>
<% if (errors.length) { %><div class="errors" role="alert"><% errors.forEach(error => { %><p><%= error %></p><% }); %></div><% } %>
<% if (entry) { %><p class="notice">Trenutno načrtovano: <strong><%= entry.title %></strong> · Število porcij: <%= entry.servings %><%= entry.available ? '' : ' · Recept ni več na voljo.' %></p><% } %>
<section class="panel stack" id="selected-meal"><h2>Izbrani obrok</h2><% if (selected) { %><h3><%= selected.title %></h3><p class="small muted">Osnovni recept: <%= selected.servings %> porcij · <%= selected.minutes %> min</p><form method="post" action="/planner/save" class="planner-save-form"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="date" value="<%= date %>"><input type="hidden" name="slot" value="<%= slot %>"><input type="hidden" name="recipe" value="<%= recipe %>"><input type="hidden" name="revision" value="<%= revision %>"><label>Število porcij<input type="number" name="servings" min="1" max="100" step="1" value="<%= servings %>" required></label><button class="button">Shrani obrok</button></form><% } else { %><p class="muted">Spodaj izberite recept. Nato določite število porcij in shranite obrok.</p><% } %></section>
<section><div class="section-heading"><div><p class="eyebrow">KAJ BO DOBREGA?</p><h2>Izberite recept</h2></div></div><form method="get" action="/planner/meal" class="filters"><input type="hidden" name="date" value="<%= date %>"><input type="hidden" name="slot" value="<%= slot %>"><% if (recipe) { %><input type="hidden" name="recipe" value="<%= recipe %>"><% } %><label>Ime recepta<input type="search" name="q" maxlength="160" value="<%= typeof query.q === 'string' ? query.q : '' %>" placeholder="Poiščite jed …"></label><label>Zbirka<select name="view"><option value="all" <%= choices.view === 'all' ? 'selected' : '' %>>Vsi recepti</option><option value="workspace" <%= choices.view === 'workspace' ? 'selected' : '' %>>Moj prostor</option><option value="public" <%= choices.view === 'public' ? 'selected' : '' %>>Samo javni</option></select></label><label class="checkbox-label"><input type="checkbox" name="favorite" value="1" <%= query.favorite === '1' ? 'checked' : '' %>> Moji priljubljeni</label><button class="button secondary">Poišči</button></form><p class="result-count muted"><%= choices.count %> receptov · Osnutki niso vključeni</p>
<% if (choices.recipes.length) { %><div class="recipe-grid"><% choices.recipes.forEach(choice => { const key = `${choice.communityId ? 'public' : 'workspace'}:${choice.id}`; %><article class="recipe-card"><div class="card-image"><% if (choice.images.length) { %><img src="<%= choice.communityId ? '/community/' + choice.id + '/images/0' : '/images/' + choice.images[0].id %>?size=small" alt="<%= choice.title %>" loading="lazy" width="600" height="450"><% } else { %><div class="food-placeholder"><span aria-hidden="true">♧</span></div><% } %></div><div class="card-content stack"><span class="small muted"><%= choice.communityId ? 'Javni recept' : 'Moj prostor' %></span><h3><%= choice.title %></h3><p class="small muted"><%= choice.prepMinutes + choice.cookMinutes %> min · Osnovno število porcij: <%= choice.servings %></p><a class="button <%= recipe === key ? '' : 'secondary' %>" href="<%= choiceLink(key) %>#selected-meal"><%= recipe === key ? 'Izbrano' : 'Izberi ta recept' %></a></div></article><% }); %></div><% if (choices.pages > 1) { %><nav class="pagination" aria-label="Strani izbire receptov"><% if (choices.page > 1) { %><a class="button secondary" href="<%= choicePage(choices.page-1) %>">← Prejšnja</a><% } %><span><%= choices.page %> / <%= choices.pages %></span><% if (choices.page < choices.pages) { %><a class="button secondary" href="<%= choicePage(choices.page+1) %>">Naslednja →</a><% } %></nav><% } %><% } else { %><div class="empty-state"><span aria-hidden="true">♧</span><h3>Ni receptov za izbrane pogoje.</h3><p>Spremenite iskanje ali najprej objavite recept v svojem prostoru.</p><a class="button secondary" href="/recipes">Na recepte</a></div><% } %></section><%- include('../layouts/footer') %>
