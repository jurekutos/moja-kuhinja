<%- include('../layouts/header') %>
<header class="page-header"><div><p class="eyebrow">MANJ RAZMIŠLJANJA. VEČ DOBRIH OBROKOV.</p><h1>Tedenski jedilnik</h1><p class="muted">Skupni načrt za <strong><%= user.householdName %></strong>. Kosila in večerje, po vašem okusu.</p></div><span class="tag"><%= plannedCount %> / <%= totalSlots %> načrtovanih obrokov</span></header>
<div class="planner-week-nav"><nav class="actions" aria-label="Izbira tedna"><a class="button secondary" href="/planner?week=<%= previous %>" aria-label="Prejšnji teden">←</a><div><p class="eyebrow">PONEDELJEK–NEDELJA</p><h2><%= dateLabel(start) %> – <%= dateLabel(end,{day:'numeric',month:'long',year:'numeric'}) %></h2></div><a class="button secondary" href="/planner?week=<%= next %>" aria-label="Naslednji teden">→</a></nav><a class="text-link" href="/planner">Ta teden</a><form action="/planner" method="get" class="planner-jump"><label for="planner-week-date">Skoči na datum</label><input type="date" id="planner-week-date" name="week" value="<%= start %>" min="1900-01-01" max="2100-12-31" required><button class="button secondary">Prikaži teden</button></form></div>
<% if (user.role === 'viewer') { %><p class="notice">Jedilnik lahko pregledujete. Obroke dodajajo in urejajo skrbniki ter uredniki vašega prostora.</p><% } %>
<%- include('preferences') %><div class="planner-grid <%= plannerMeals === 'both' ? '' : 'single-slot' %>"><% days.forEach(day => { %><section class="planner-day <%= day.isToday ? 'is-today' : '' %>" id="day-<%= day.date %>" aria-label="<%= day.name %>, <%= dateLabel(day.date) %>"><header><h2><%= day.name %></h2><p class="muted"><%= dateLabel(day.date,{day:'numeric',month:'numeric'}) %><% if (day.isToday) { %> <span class="tag">Danes</span><% } %></p></header><div class="planner-day-meals"><% day.meals.forEach(meal => { const entry = meal.entry; %><article class="planner-slot"><p class="eyebrow"><%= meal.label %></p><% if (entry) { %><h3><% if (entry.available) { %><a href="<%= entry.href %>?servings=<%= entry.servings %>"><%= entry.title %></a><% } else { %><%= entry.title %><% } %></h3><p class="small muted">Število porcij: <strong><%= entry.servings %></strong></p><% if (entry.available) { %><p class="small muted">◷ <%= entry.minutes %> min</p><a class="text-link" href="<%= entry.href %>?servings=<%= entry.servings %>">Odpri recept →</a><% } else { %><p class="small danger">Recept ni več na voljo. Zamenjajte ga z drugim.</p><% } %><% if (user.role !== 'viewer') { %><a class="text-link" href="/planner/meal?date=<%= day.date %>&amp;slot=<%= meal.slot %>">Uredi obrok</a><form method="post" action="/planner/remove" data-confirm="Odstranim ta obrok iz jedilnika?"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="date" value="<%= day.date %>"><input type="hidden" name="slot" value="<%= meal.slot %>"><input type="hidden" name="revision" value="<%= entry.revision %>"><button class="text-link danger">Odstrani obrok</button></form><% } %><% } else { %><div class="planner-empty"><span aria-hidden="true">＋</span><p class="small muted">Še ni načrtovano</p><% if (user.role !== 'viewer') { %><a class="button secondary" href="/planner/meal?date=<%= day.date %>&amp;slot=<%= meal.slot %>">Dodaj obrok</a><% } %></div><% } %></article><% }); %></div></section><% }); %></div>
<p class="small muted planner-footnote">Porcije veljajo za načrtovani obrok in ne spreminjajo osnovnega recepta. Izberete lahko objavljene recepte svojega prostora in odobrene javne recepte.</p><%- include('../layouts/footer') %>
