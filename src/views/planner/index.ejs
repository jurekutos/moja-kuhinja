<%- include('../layouts/header') %>
<header class="page-header"><div><p class="eyebrow"><%= t("planner:s88eb571abb54") %></p><h1><%= t("planner:s0a29cce93bbd") %></h1><p class="muted"><%= t("planner:s31ebe36951c0") %> <strong><%= user.householdName %></strong><%= t("planner:s879c13a79e73") %></p></div><span class="tag"><%= plannedCount %> / <%= totalSlots %> <%= t("planner:sa486e67c4eba") %></span></header>
<div class="planner-week-nav"><nav class="actions" aria-label="<%= t("planner:s3f6e5c600894") %>"><a class="button secondary" href="/planner?week=<%= previous %>" aria-label="<%= t("planner:saa914dc40583") %>">←</a><div><p class="eyebrow"><%= t("planner:s2d8a8b6addff") %></p><h2><%= dateLabel(start) %> – <%= dateLabel(end,{day:'numeric',month:'long',year:'numeric'}) %></h2></div><a class="button secondary" href="/planner?week=<%= next %>" aria-label="<%= t("planner:s652e259b1621") %>">→</a></nav><a class="text-link" href="/planner"><%= t("planner:s03431aa5f646") %></a><form action="/planner" method="get" class="planner-jump"><label for="planner-week-date"><%= t("planner:sa98a49345e55") %></label><input type="date" id="planner-week-date" name="week" value="<%= start %>" min="1900-01-01" max="2100-12-31" required><button class="button secondary"><%= t("planner:sac3313e2d24f") %></button></form></div>
<% if (user.role === 'viewer') { %><p class="notice"><%= t("planner:s7b335b879bf7") %></p><% } %>
<%- include('preferences') %><div class="planner-grid <%= plannerMeals === 'both' ? '' : 'single-slot' %>"><% days.forEach(day => { %><section class="planner-day <%= day.isToday ? 'is-today' : '' %>" id="day-<%= day.date %>" aria-label="<%= day.name %>, <%= dateLabel(day.date) %>"><header><h2><%= day.name %></h2><p class="muted"><%= dateLabel(day.date,{day:'numeric',month:'numeric'}) %><% if (day.isToday) { %> <span class="tag"><%= t("planner:s06659c4b2c85") %></span><% } %></p></header><div class="planner-day-meals"><% day.meals.forEach(meal => { const entry = meal.entry; %><article class="planner-slot"><p class="eyebrow"><%= meal.label %></p><% if (entry) { %><h3><% if (entry.available) { %><a href="<%= entry.href %>?servings=<%= entry.servings %>"><%= entry.title %></a><% } else { %><%= entry.title %><% } %></h3><p class="small muted"><%= t("planner:s6d67007f3368") %> <strong><%= entry.servings %></strong></p><% if (entry.available) { %><p class="small muted">◷ <%= entry.minutes %> <%= t("planner:s1f6fa6f69d18") %></p><a class="text-link" href="<%= entry.href %>?servings=<%= entry.servings %>"><%= t("planner:s67171de32744") %></a><% } else { %><p class="small danger"><%= t("planner:sc041aa84f640") %></p><% } %><% if (user.role !== 'viewer') { %><a class="text-link" href="/planner/meal?date=<%= day.date %>&amp;slot=<%= meal.slot %>"><%= t("planner:s709440abd319") %></a><form method="post" action="/planner/remove" data-confirm="<%= t("planner:s48d4305a3028") %>"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="date" value="<%= day.date %>"><input type="hidden" name="slot" value="<%= meal.slot %>"><input type="hidden" name="revision" value="<%= entry.revision %>"><button class="text-link danger"><%= t("planner:s95d9a8e922f1") %></button></form><% } %><% } else { %><div class="planner-empty"><span aria-hidden="true">＋</span><p class="small muted"><%= t("planner:s4650518d8fbe") %></p><% if (user.role !== 'viewer') { %><a class="button secondary" href="/planner/meal?date=<%= day.date %>&amp;slot=<%= meal.slot %>"><%= t("planner:s25a5b1b19474") %></a><% } %></div><% } %></article><% }); %></div></section><% }); %></div>
<p class="small muted planner-footnote"><%= t("planner:s73b2fb753d35") %></p><%- include('../layouts/footer') %>
