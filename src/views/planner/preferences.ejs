<% if (user.role !== 'viewer') { %><form action="/planner/preferences" method="post" class="planner-preferences panel"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="week" value="<%= start %>"><label for="planner-meals">Katere obroke želite načrtovati?<select id="planner-meals" name="meals"><option value="both" <%= plannerMeals === 'both' ? 'selected' : '' %>>Kosilo in večerja</option><option value="lunch" <%= plannerMeals === 'lunch' ? 'selected' : '' %>>Samo kosilo</option><option value="dinner" <%= plannerMeals === 'dinner' ? 'selected' : '' %>>Samo večerja</option></select></label><button class="button secondary">Shrani prikaz</button><p class="small muted">Nastavitev velja za vse člane prostora in vse tedne. Skriti obroki ostanejo shranjeni.</p></form><% } %>
<% if (hiddenCount) { %><p class="notice">Skritih načrtovanih obrokov v tem tednu: <%= hiddenCount %>. Ponovno omogočite oba obroka, da jih prikažete.</p><% } %>
