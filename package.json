{
  "name": "moja-kuhinja",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.21"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  },
  "allowScripts": {
    "argon2": true,
    "better-sqlite3": true,
    "esbuild": true,
    "@parcel/watcher": true
  },
  "scripts": {
    "dev": "node --env-file=.env --watch src/server.js",
    "start": "node --env-file=.env src/server.js",
    "build": "tailwindcss -i src/styles.css -o public/css/app.css --minify",
    "css:watch": "tailwindcss -i src/styles.css -o public/css/app.css --watch",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file=.env scripts/migrate.js",
    "setup": "node --env-file=.env scripts/setup.js",
    "storage:clean": "node --env-file=.env scripts/clean-storage.js",
    "backup": "node --env-file=.env scripts/backup.js",
    "super-admin:grant": "node --env-file=.env scripts/grant-super-admin.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "test:browser": "node scripts/browser-smoke.js",
    "test:browser:i18n": "node scripts/browser-i18n.js",
    "seed:public": "node --env-file=.env scripts/seed-public-library.js",
    "test:browser:library": "node scripts/browser-library.js"
  },
  "dependencies": {
    "argon2": "^0.44.0",
    "better-sqlite3": "^12.4.1",
    "decimal.js": "^10.6.0",
    "drizzle-orm": "^0.45.4",
    "ejs": "^3.1.10",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "express-session": "^1.18.2",
    "helmet": "^8.1.0",
    "i18next": "^27.1.2",
    "multer": "^2.0.2",
    "sharp": "^0.35.5",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.17",
    "drizzle-kit": "^0.31.11",
    "playwright-core": "^1.65.1",
    "supertest": "^7.1.4",
    "tailwindcss": "^4.1.17"
  }
}
